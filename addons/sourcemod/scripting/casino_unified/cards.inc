public int Cards_SetupHandler(Menu m,MenuAction action,int c,int item){
    if(action==MenuAction_End){Cards_MenuEnd(m);return 0;}if(Cards_ending||action!=MenuAction_Select||!Cards_Admin(c))return 0;
