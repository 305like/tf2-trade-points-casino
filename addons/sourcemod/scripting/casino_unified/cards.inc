                    blocker=other;if(origin[2]+maxs[2]+2.0>top)top=origin[2]+maxs[2]+2.0;
                }
            }
            if(!blocker)return true;
            point[2]=top;if(!Cards_SeatClear(c,point))break;
        }
    }
    return false;
}
bool Cards_SeatExitPoint(int c,int s,float point[3]){
    for(int i=0;i<8;i++){
        float a=DegToRad(Cards_machines[s].yaw+float(i)*45.0),start[3],end[3];start=Cards_machines[s].chairOrigin;
        start[0]+=Cosine(a)*65.0;start[1]+=Sine(a)*65.0;start[2]+=50.0;end=start;end[2]-=100.0;
        Handle tr=TR_TraceRayFilterEx(start,end,MASK_PLAYERSOLID,RayType_EndPoint,Cards_SeatTrace,c);
        if(!TR_DidHit(tr)||TR_StartSolid(tr)||TR_AllSolid(tr)){delete tr;continue;}float normal[3];TR_GetEndPosition(point,tr);TR_GetPlaneNormal(tr,normal);delete tr;
        if(FloatAbs(point[2]-Cards_machines[s].chairOrigin[2])>48.0)continue;
        point[2]+=2.0;if(normal[2]>=0.7&&Cards_SeatExitClear(c,point))return true;
    }
    point=Cards_seatEntry[c];point[2]+=2.0;return Cards_SeatExitClear(c,point);
}
void Cards_SeatStop(int c,bool requested){
    if(c<1||c>MaxClients||!Cards_seatSlot[c])return;
    int s=Cards_seatSlot[c]-1;
    if(requested&&Cards_machines[s].busy){PrintToChat(c,"[더블] 게임 결과가 나온 뒤 내릴 수 있습니다.");return;}
    float point[3];bool place=Cards_Player(c)&&Cards_SeatExitPoint(c,s,point);
    if(requested&&!place){PrintToChat(c,"[더블] 하차할 공간이 없습니다.");return;}
#if defined DON_GAME_POINTS
    if(gameRound[s]>0&&!Cards_machines[s].cashing){if(Cards_machines[s].busy)Finish(s);GamePoints_Don(c,3,0,gameRound[s]);}
#endif
    Cards_seatSlot[c]=0;
    if(!IsClientInGame(c))return;
    if(Cards_seatPushaway!=null&&!IsFakeClient(c)){
        char value[16];Cards_seatPushaway.GetString(value,sizeof(value));SendConVarValue(c,Cards_seatPushaway,value);
    }
    Cards_SeatViewStop(c);
    char current[PLATFORM_MAX_PATH];GetEntPropString(c,Prop_Send,"m_iszCustomModel",current,sizeof(current));
    if(StrEqual(current,Cards_SEAT_CAMERA_RIG)){
        SetVariantString(Cards_seatOldModel[c]);AcceptEntityInput(c,"SetCustomModel");SetEntProp(c,Prop_Send,"m_bUseClassAnimations",Cards_seatAnimations[c]);
        SetEntProp(c,Prop_Send,"m_nSkin",Cards_seatSkin[c]);SetEntProp(c,Prop_Send,"m_nBody",Cards_seatGroups[c]);
        Cards_SeatViewRestoreModel(c);
    }
    int body=Cards_Entity(Cards_seatBody[c]);Cards_seatBody[c]=INVALID_ENT_REFERENCE;if(body!=-1)RemoveEntity(body);
    if(GetEntityRenderFx(c)==RENDERFX_FADE_FAST)SetEntityRenderFx(c,Cards_seatFx[c]);
    SetEntProp(c,Prop_Send,"m_nForceTauntCam",0);SetEntPropVector(c,Prop_Data,"m_vecViewOffset",Cards_seatOldEye[c]);
    if(GetEntityMoveType(c)==MOVETYPE_NONE)SetEntityMoveType(c,Cards_seatMove[c]);
    if(place){float zero[3];TeleportEntity(c,point,NULL_VECTOR,zero);}
    Cards_SeatPhysicsRestore(c);
    Cards_Release(s);
    LogMessage("DON seat exit userid=%d slot=%d",GetClientUserId(c),s);
}
void Cards_SeatsFrame(){
    for(int c=1;c<=MaxClients;c++)if(Cards_seatSlot[c]){
        if(!Cards_Player(c)||Cards_Entity(Cards_machines[Cards_seatSlot[c]-1].chair)==-1){Cards_SeatStop(c,false);continue;}
        if(!Cards_SeatStoreWeapons(c)){Cards_SeatStop(c,false);continue;}
        float origin[3],zero[3];GetClientAbsOrigin(c,origin);
        // Preserve mouse look; repair only displacement from the fixed seat anchor.
        if(GetVectorDistance(origin,Cards_machines[Cards_seatSlot[c]-1].chairOrigin,true)>0.0001){
            int parity=GetEntProp(c,Prop_Send,"m_ubInterpolationFrame");
            TeleportEntity(c,Cards_machines[Cards_seatSlot[c]-1].chairOrigin,NULL_VECTOR,zero);
            SetEntProp(c,Prop_Send,"m_ubInterpolationFrame",parity);
        }
        SetEntityMoveType(c,MOVETYPE_NONE);
        Cards_SeatPhysicsHold(c);
        if(!Cards_SeatViewUpdate(c)){Cards_SeatStop(c,false);continue;}
        float eye[3];eye[2]=Cards_seatEyes[view_as<int>(TF2_GetPlayerClass(c))];SetEntPropVector(c,Prop_Data,"m_vecViewOffset",eye);
    }
}

