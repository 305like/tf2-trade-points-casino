public Action Cards_OpenGame(int c,int args){if(Cards_Player(c)&&Cards_seatSlot[c])Cards_ShowGame(c);else if(c>0)PrintToChat(c,"[카드] 테이블/의자를 보고 E키 또는 메딕 호출로 앉으세요.");return Plugin_Handled;}
public bool Cards_CardSeatTrace(int e,int mask,any data){
    if(e==0)return true;
    if(e<=MaxClients)return false;
    for(int t=0;t<Cards_TABLES;t++)if(e==Cards_Entity(Cards_tables[t].body))return true;
    for(int s=0;s<Cards_COUNT;s++)if(e==Cards_Entity(Cards_machines[s].chair))return true;
    return false;
}
bool Cards_CardSeatOccupied(int s){
    for(int c=1;c<=MaxClients;c++)if(Cards_seatSlot[c]==s+1)return true;
    return false;
}
bool Cards_CardSeatUse(int c){
    float eye[3],angles[3],direction[3],end[3];
    GetClientEyePosition(c,eye);GetClientEyeAngles(c,angles);GetAngleVectors(angles,direction,NULL_VECTOR,NULL_VECTOR);
    for(int i=0;i<3;i++)end[i]=eye[i]+direction[i]*120.0;
    Handle tr=TR_TraceRayFilterEx(eye,end,MASK_SOLID,RayType_EndPoint,Cards_CardSeatTrace);
    int hit=TR_DidHit(tr)?TR_GetEntityIndex(tr):-1;delete tr;
    if(hit<=MaxClients)return false;
    for(int s=0;s<Cards_COUNT;s++)if(hit==Cards_Entity(Cards_machines[s].chair)){
        if(Cards_CardSeatOccupied(s))PrintToChat(c,"[카드] 이미 앉아 있는 의자입니다.");else Cards_SeatBegin(c,s);
        return true;
    }
    for(int t=0;t<Cards_TABLES;t++)if(hit==Cards_Entity(Cards_tables[t].body)){
        int best=-1;float distance=999999999.0,origin[3];GetClientAbsOrigin(c,origin);
        for(int i=0;i<6;i++){
            int s=t*6+i;if(Cards_Entity(Cards_machines[s].chair)==-1||Cards_CardSeatOccupied(s))continue;
            float candidate=GetVectorDistance(origin,Cards_machines[s].chairOrigin,true);
            if(candidate<distance){distance=candidate;best=s;}
        }
        if(best==-1)PrintToChat(c,"[카드] 빈 의자가 없습니다.");else Cards_SeatBegin(c,best);
        return true;
    }
    return false;
}
public Action Cards_CardMedicCall(int c,const char[] command,int args){
    if(!Cards_ready||!Cards_Player(c)||args!=2)return Plugin_Continue;
    char menu[8],item[8];GetCmdArg(1,menu,sizeof(menu));GetCmdArg(2,item,sizeof(item));
