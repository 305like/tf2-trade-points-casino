public int Cards_GameHandler(Menu m,MenuAction action,int c,int item){
    if(action==MenuAction_End){Cards_MenuEnd(m);return 0;}
    if(Cards_ending||action!=MenuAction_Select||!Cards_Player(c)||!Cards_seatSlot[c])return 0;
    char key[64],parts[2][32];m.GetItem(item,key,sizeof(key));
    if(ExplodeString(key,":",parts,2,32)!=2||StringToInt(parts[0])!=Cards_revision[c]){Cards_ShowGame(c);return 0;}
    Cards_revision[c]++;int s=Cards_seatSlot[c]-1,t=s/6,i=s%6;
    if(StrEqual(parts[1],"leave")){Cards_SeatStop(c,true);return 0;}
    if(GetGameTime()<Cards_viewBusy[t]||GetGameTime()<Cards_viewBJHold[c]||GetGameTime()<Cards_viewHold[t]){Cards_ShowGame(c);return 0;}
    if(StrEqual(parts[1],"refill")){if(Cards_chips[c]<10&&!Cards_blackjack[c].active&&!Cards_tables[t].phase)Cards_chips[c]=1000;}
    else if(Cards_tables[t].kind==0){
        if(!Cards_blackjack[c].active){
            if(StrEqual(parts[1],"deal"))Cards_DealBJ(c);
            else if(StrEqual(parts[1],"plus")&&Cards_bet[c]<500)Cards_bet[c]+=10;
            else if(StrEqual(parts[1],"minus")&&Cards_bet[c]>10)Cards_bet[c]-=10;
            else if(StrEqual(parts[1],"input")){Cards_typing[c]=true;PrintToChat(c,"[카드] 베팅 10~500을 10단위로 채팅 입력. 취소: !취소");return 0;}
        }else if(StrEqual(parts[1],"hit")){Cards_BJDraw(c);if(Cards_BlackjackValue(Cards_blackjack[c].hand,Cards_blackjack[c].count)>=21)Cards_FinishBJ(c);}
        else if(StrEqual(parts[1],"stand"))Cards_FinishBJ(c);
        else if(StrEqual(parts[1],"double")&&Cards_blackjack[c].count==2&&Cards_chips[c]>=Cards_blackjack[c].wager){Cards_chips[c]-=Cards_blackjack[c].wager;Cards_blackjack[c].wager*=2;Cards_BJDraw(c);Cards_FinishBJ(c);}
    }else {
        if(StrEqual(parts[1],"start")&&!Cards_tables[t].phase)Cards_StartPoker(t);
        else if(Cards_tables[t].phase&&Cards_tables[t].actor==i&&Cards_tables[t].users[i]==GetClientUserId(c))Cards_PokerAction(t,i,parts[1]);
    }
    if(Cards_seatSlot[c])Cards_ShowGame(c);return 0;
}
public Action Cards_Chat(int c,const char[] cmd,int args){
    if(c<1||!IsClientInGame(c)||!Cards_typing[c])return Plugin_Continue;
    char text[128];GetCmdArgString(text,sizeof(text));StripQuotes(text);TrimString(text);
    if(text[0]=='!'||text[0]=='/'){Cards_typing[c]=false;return Plugin_Continue;}
    if(!Cards_seatSlot[c]||Cards_blackjack[c].active){Cards_typing[c]=false;return Plugin_Continue;}
    int n=strlen(text);bool valid=n>0&&n<=3;for(int i=0;i<n;i++)if(text[i]<'0'||text[i]>'9')valid=false;
    int v=StringToInt(text);if(!valid||v<10||v>500||v%10){PrintToChat(c,"[카드] 10~500 / 10단위 숫자를 입력하세요.");return Plugin_Handled;}
    Cards_bet[c]=v;Cards_typing[c]=false;Cards_ShowGame(c);return Plugin_Handled;
}
void Cards_DealBJ(int c){
    if(Cards_blackjack[c].active||Cards_chips[c]<Cards_bet[c])return;
    Cards_BJ empty;Cards_blackjack[c]=empty;Cards_blackjack[c].active=true;Cards_blackjack[c].wager=Cards_bet[c];Cards_chips[c]-=Cards_bet[c];
    Cards_Shuffle(Cards_blackjack[c].deck);Cards_blackjack[c].count=Cards_blackjack[c].dc=2;
    Cards_blackjack[c].hand[0]=Cards_blackjack[c].deck[0];Cards_blackjack[c].dealer[0]=Cards_blackjack[c].deck[1];
    Cards_blackjack[c].hand[1]=Cards_blackjack[c].deck[2];Cards_blackjack[c].dealer[1]=Cards_blackjack[c].deck[3];Cards_blackjack[c].cursor=4;
    Cards_blackjack[c].due=GetGameTime()+30.0;Cards_SoundAt((Cards_seatSlot[c]-1)/6,1);
    Cards_ViewBJ(c);
    if(Cards_BlackjackValue(Cards_blackjack[c].hand,2)==21||Cards_BlackjackValue(Cards_blackjack[c].dealer,2)==21)Cards_FinishBJ(c);
}
void Cards_BJDraw(int c){
    if(Cards_blackjack[c].count>=12||Cards_blackjack[c].cursor>=52){Cards_FinishBJ(c);return;}
    Cards_blackjack[c].hand[Cards_blackjack[c].count++]=Cards_blackjack[c].deck[Cards_blackjack[c].cursor++];Cards_blackjack[c].due=GetGameTime()+30.0;
    Cards_ViewBJ(c);
}
void Cards_FinishBJ(int c){
    if(!Cards_blackjack[c].active)return;Cards_blackjack[c].active=false;
    int player=Cards_BlackjackValue(Cards_blackjack[c].hand,Cards_blackjack[c].count);
    bool natural=player==21&&Cards_blackjack[c].count==2;
    while(player<=21&&!natural&&Cards_BlackjackValue(Cards_blackjack[c].dealer,Cards_blackjack[c].dc)<17&&Cards_blackjack[c].dc<12)
        Cards_blackjack[c].dealer[Cards_blackjack[c].dc++]=Cards_blackjack[c].deck[Cards_blackjack[c].cursor++];
    int house=Cards_BlackjackValue(Cards_blackjack[c].dealer,Cards_blackjack[c].dc),reward;
    bool dn=house==21&&Cards_blackjack[c].dc==2;
    if(player<=21){if(natural&&!dn)reward=Cards_blackjack[c].wager*5/2;else if(natural&&dn)reward=Cards_blackjack[c].wager;else if(!dn){if(house>21||player>house)reward=Cards_blackjack[c].wager*2;else if(player==house)reward=Cards_blackjack[c].wager;}}
    Cards_AddChips(c,reward);char cards[160];Cards_CardsText(Cards_blackjack[c].dealer,Cards_blackjack[c].dc,cards,sizeof(cards));
    PrintToChat(c,"[블랙잭] 내 점수 %d / 딜러 %s = %d / 반환 %d (원금 포함)",player,cards,house,reward);
    if(Cards_seatSlot[c]){Cards_ViewBJ(c,true);Cards_viewBJHold[c]=GetGameTime()+5.0;Cards_SoundAt((Cards_seatSlot[c]-1)/6,natural&&reward>Cards_blackjack[c].wager?9:7);}
}

bool Cards_CanAct(int t,int i){int c=Cards_Owner(t,i);return c>0&&!Cards_tables[t].folded[i]&&Cards_chips[c]>0;}
bool Cards_CanRaise(int t,int i){for(int j=0;j<6;j++)if(j!=i&&Cards_CanAct(t,j))return true;return false;}
int Cards_NextPlayer(int t,int after){for(int k=1;k<=6;k++){int i=(after+k)%6;if(Cards_tables[t].users[i]&&!Cards_tables[t].folded[i])return i;}return -1;}
void Cards_Pay(int t,int i,int amount){int c=Cards_Owner(t,i);if(!c)return;if(amount>Cards_chips[c])amount=Cards_chips[c];if(amount<0)return;Cards_chips[c]-=amount;Cards_tables[t].paid[i]+=amount;Cards_tables[t].street[i]+=amount;}
void Cards_StartPoker(int t){
    if(GetGameTime()<Cards_viewHold[t]||GetGameTime()<Cards_viewBusy[t])return;
    int count,users[6];for(int i=0;i<6;i++){int c=Cards_Seated(t*6+i);if(c&&Cards_chips[c]>=10){users[i]=GetClientUserId(c);count++;}}
    if(count<2){for(int i=0;i<6;i++){int c=Cards_Seated(t*6+i);if(c)PrintToChat(c,"[포커] 가상 칩 10 이상인 플레이어가 2명 필요합니다.");}return;}
    Cards_ViewCollect(t,0,35);Cards_viewNextHand[t]=0.0;strcopy(Cards_viewLog[t],sizeof(Cards_viewLog[]),"NEW HAND / DEALING");
    Cards_tables[t].discarded=0;
    Cards_tables[t].phase=1;Cards_tables[t].cursor=0;Cards_tables[t].shown=0;Cards_tables[t].current=10;Cards_tables[t].raises=0;
    Cards_Shuffle(Cards_tables[t].deck);
    for(int i=0;i<6;i++){
        Cards_tables[t].users[i]=users[i];Cards_tables[t].paid[i]=Cards_tables[t].street[i]=0;Cards_tables[t].folded[i]=users[i]==0;Cards_tables[t].pending[i]=users[i]!=0;Cards_tables[t].acted[i]=false;
        Cards_tables[t].drawMask[i]=0;
        if(users[i])for(int j=0;j<(Cards_tables[t].kind==2?5:2);j++)Cards_tables[t].hole[i*5+j]=Cards_tables[t].deck[Cards_tables[t].cursor++];
    }
    Cards_tables[t].dealer=Cards_NextPlayer(t,Cards_tables[t].dealer);
    int small=count==2?Cards_tables[t].dealer:Cards_NextPlayer(t,Cards_tables[t].dealer),big=Cards_NextPlayer(t,small);
    Cards_Pay(t,small,5);Cards_Pay(t,big,10);Cards_SoundAt(t,1);Cards_Advance(t,big);
}
void Cards_PokerAction(int t,int i,const char[] action){
    if(Cards_tables[t].kind==2&&Cards_tables[t].phase==2){
        if(Cards_tables[t].actor!=i||!Cards_Owner(t,i)||Cards_tables[t].folded[i])return;
        if(action[0]=='d'&&action[1]>='0'&&action[1]<='4'&&action[2]==0){Cards_tables[t].drawMask[i]^=1<<(action[1]-'0');return;}
        if(!StrEqual(action,"draw"))return;
        Cards_PokerReplace(Cards_tables[t].hole,i,Cards_tables[t].drawMask[i],Cards_tables[t].deck,Cards_tables[t].cursor,Cards_tables[t].discard,Cards_tables[t].discarded);
        Cards_tables[t].pending[i]=false;Cards_SoundAt(t,0);Cards_Advance(t,i);return;
    }
    if(!Cards_CanAct(t,i)||Cards_tables[t].actor!=i)return;
    int c=Cards_Owner(t,i),call=Cards_tables[t].current-Cards_tables[t].street[i];
    if(StrEqual(action,"fold")){Cards_tables[t].folded[i]=true;Cards_SoundAt(t,4);}
    else if(StrEqual(action,"call")){Cards_Pay(t,i,call);Cards_SoundAt(t,call>0?8:6);}
    else if(StrEqual(action,"raise")){
        if(Cards_tables[t].acted[i]||Cards_tables[t].raises>=4||Cards_chips[c]<=call||!Cards_CanRaise(t,i))return;
        int step=Cards_tables[t].phase>=3?20:10,old=Cards_tables[t].current;
        Cards_Pay(t,i,call+step);Cards_tables[t].current=Cards_tables[t].street[i];
        bool full=Cards_tables[t].current-old>=step;if(full)Cards_tables[t].raises++;
        for(int j=0;j<6;j++)if(j!=i&&Cards_CanAct(t,j)){Cards_tables[t].pending[j]=true;if(full)Cards_tables[t].acted[j]=false;}
        Cards_SoundAt(t,2);
    }else return;
    Cards_ViewAction(t,c,StrEqual(action,"fold")?"FOLD":(StrEqual(action,"raise")?"RAISE":(call>0?"CALL":"CHECK")));
    Cards_tables[t].pending[i]=false;Cards_tables[t].acted[i]=true;Cards_Advance(t,i);
}
void Cards_Advance(int t,int after){
    if(!Cards_tables[t].phase)return;
    int active;
    for(int i=0;i<6;i++){if(Cards_tables[t].users[i]&&!Cards_Owner(t,i))Cards_tables[t].folded[i]=true;if(Cards_tables[t].users[i]&&!Cards_tables[t].folded[i])active++;}
    if(active<=1){Cards_SettlePoker(t);return;}
    // At most four streets, so all-in runout cannot loop indefinitely.
    for(int round=0;round<5;round++){
        int actors;for(int i=0;i<6;i++)if(Cards_CanAct(t,i))actors++;
        for(int k=1;k<=6;k++){
            int i=(after+k)%6;bool drawing=Cards_tables[t].kind==2&&Cards_tables[t].phase==2;
            if(!Cards_tables[t].pending[i]||Cards_tables[t].folded[i]||!Cards_Owner(t,i)||(!drawing&&!Cards_CanAct(t,i)))continue;
            if(!drawing&&actors==1&&Cards_tables[t].street[i]>=Cards_tables[t].current){Cards_tables[t].pending[i]=false;continue;}
            Cards_tables[t].actor=i;Cards_tables[t].Cards_revision++;Cards_tables[t].due=GetGameTime()+30.0;
            int c=Cards_Owner(t,i);if(c)EmitSoundToClient(c,Cards_sounds[5]);Cards_RefreshTable(t);return;
        }
        if(Cards_tables[t].phase==(Cards_tables[t].kind==2?3:4)){Cards_SettlePoker(t);return;}
        if(Cards_tables[t].kind==2){
            Cards_tables[t].phase++;Cards_tables[t].current=0;Cards_tables[t].raises=0;
            for(int i=0;i<6;i++){Cards_tables[t].street[i]=0;Cards_tables[t].pending[i]=Cards_tables[t].phase==2?(Cards_Owner(t,i)>0&&!Cards_tables[t].folded[i]):Cards_CanAct(t,i);Cards_tables[t].acted[i]=false;}
            after=Cards_tables[t].dealer;continue;
        }
        Cards_tables[t].phase++;Cards_tables[t].cursor++; // Burn one before flop/turn/river.
        int draw=Cards_tables[t].phase==2?3:1;
        for(int k=0;k<draw;k++)Cards_tables[t].board[Cards_tables[t].shown++]=Cards_tables[t].deck[Cards_tables[t].cursor++];
        Cards_tables[t].current=0;Cards_tables[t].raises=0;
        for(int i=0;i<6;i++){Cards_tables[t].street[i]=0;Cards_tables[t].pending[i]=Cards_CanAct(t,i);Cards_tables[t].acted[i]=false;}
        after=Cards_tables[t].dealer;
    }
}
void Cards_RefreshTable(int t){if(Cards_tables[t].phase)Cards_ViewPoker(t);for(int i=0;i<6;i++){int c=Cards_Seated(t*6+i);if(c)Cards_ShowGame(c);}}
void Cards_SettlePoker(int t){
    int ranks[6],awards[6],seven[7],survivors;
    for(int i=0;i<6;i++)if(Cards_tables[t].users[i]&&!Cards_tables[t].folded[i])survivors++;
    for(int i=0;i<6;i++)if(Cards_tables[t].users[i]&&!Cards_tables[t].folded[i]){
        if(Cards_tables[t].kind==2){int own[5];for(int j=0;j<5;j++)own[j]=Cards_tables[t].hole[i*5+j];ranks[i]=Cards_PokerFive(own);}
        else if(Cards_tables[t].shown==5){seven[0]=Cards_tables[t].hole[i*5];seven[1]=Cards_tables[t].hole[i*5+1];for(int j=0;j<5;j++)seven[j+2]=Cards_tables[t].board[j];ranks[i]=Cards_PokerSeven(seven);}
        else ranks[i]=1;
    }
    Cards_SplitPots(Cards_tables[t].paid,Cards_tables[t].folded,ranks,Cards_tables[t].dealer,awards);
    int paid,total;for(int i=0;i<6;i++){paid+=Cards_tables[t].paid[i];total+=awards[i];}
    if(total!=paid){LogError("Pot conservation failure");for(int i=0;i<6;i++)awards[i]=Cards_tables[t].paid[i];}
    Cards_tables[t].phase=0;Cards_tables[t].actor=-1;
    Cards_ViewPoker(t,(Cards_tables[t].shown==5||Cards_tables[t].kind==2)&&survivors>1);Cards_viewHold[t]=GetGameTime()+5.0;
    for(int i=0;i<6;i++){
        int c=Cards_Owner(t,i);Cards_AddChips(c,awards[i]);
        if(c)PrintToChat(c,"[포커] 이번 판 투입 %d / 반환 %d / 가상 칩 %d",Cards_tables[t].paid[i],awards[i],Cards_chips[c]);
        if(!Cards_tables[t].folded[i]&&(Cards_tables[t].shown==5||Cards_tables[t].kind==2)&&survivors>1){int own[5];for(int j=0;j<5;j++)own[j]=Cards_tables[t].hole[i*5+j];char cards[96],name[64];Cards_CardsText(own,Cards_tables[t].kind==2?5:2,cards,sizeof(cards));if(c)GetClientName(c,name,sizeof(name));else strcopy(name,sizeof(name),"퇴장한 플레이어");for(int j=0;j<6;j++){int viewer=Cards_Seated(t*6+j);if(viewer)PrintToChat(viewer,"[포커 공개] %s: %s / 족보 등급 %d",name,cards,ranks[i]/759375);}}
    }
    for(int i=0;i<6;i++)Cards_tables[t].paid[i]=0;
    Cards_SoundAt(t,3);Cards_RefreshTable(t);
}
public Action Cards_OnPlayerRunCmd(int c,int &buttons,int &impulse,float velocity[3],float angles[3],int &weapon){
    if(!Cards_Player(c)||!Cards_ready)return Plugin_Continue;int old=Cards_previous[c];Cards_previous[c]=buttons;
    if(!Cards_seatSlot[c]){if((buttons&IN_USE)&&!(old&IN_USE)&&GetGameTime()>=Cards_nextUse[c]){Cards_nextUse[c]=GetGameTime()+0.3;Cards_CardSeatUse(c);}return Plugin_Continue;}
    if((buttons&IN_DUCK)&&!(old&IN_DUCK)){Cards_SeatStop(c,true);if(!Cards_seatSlot[c])return Plugin_Continue;}
    if((buttons&IN_ATTACK3)&&!(old&IN_ATTACK3))Cards_seatThird[c]=!Cards_seatThird[c];
    if((buttons&IN_USE)&&!(old&IN_USE)&&GetGameTime()>=Cards_nextUse[c]){Cards_nextUse[c]=GetGameTime()+0.3;Cards_ShowGame(c);}
    buttons&=~(IN_ATTACK|IN_ATTACK2|IN_ATTACK3|IN_JUMP|IN_DUCK|IN_USE|IN_RELOAD|IN_FORWARD|IN_BACK|IN_MOVELEFT|IN_MOVERIGHT);buttons|=IN_DUCK;Cards_SeatPhysicsHold(c);weapon=0;
    velocity[0]=velocity[1]=velocity[2]=0.0;return Plugin_Changed;
}
public void Cards_OnGameFrame(){
    if(!Cards_ready||Cards_ending)return;Cards_SeatsFrame();Cards_CasinoHintFrame();float now=GetGameTime();Cards_ViewFrame(now);if(now<Cards_nextFrame)return;Cards_nextFrame=now+0.5;
    for(int t=0;t<Cards_TABLES;t++)if(Cards_viewBusy[t]>0.0&&now>=Cards_viewBusy[t]){
        Cards_viewBusy[t]=0.0;for(int i=0;i<6;i++){int c=Cards_Seated(t*6+i);if(c)Cards_ShowGame(c);}
    }
    for(int c=1;c<=MaxClients;c++)if(Cards_seatSlot[c]&&Cards_Player(c)){
        if(Cards_blackjack[c].active&&now>=Cards_blackjack[c].due){Cards_FinishBJ(c);Cards_ShowGame(c);}
        int t=(Cards_seatSlot[c]-1)/6;int seconds;
        if(Cards_tables[t].phase)seconds=RoundToCeil(Cards_tables[t].due-now);else if(Cards_blackjack[c].active)seconds=RoundToCeil(Cards_blackjack[c].due-now);
        SetHudTextParams(0.02,0.25,0.7,255,225,100,255);
        char actor[64]="대기";if(Cards_tables[t].phase){int p=Cards_Owner(t,Cards_tables[t].actor);if(p)GetClientName(p,actor,sizeof(actor));}
        ShowHudText(c,4,"[가상 칩] %d\n차례: %s · 남은 시간 %d초\nE/메딕: 메뉴 / Ctrl: 하차 / 휠: 시점",Cards_chips[c],actor,seconds>0?seconds:0);
    }
    for(int t=0;t<Cards_TABLES;t++)if(Cards_tables[t].phase&&now>=Cards_tables[t].due){int i=Cards_tables[t].actor;if(i>=0){if(Cards_tables[t].kind==2&&Cards_tables[t].phase==2)Cards_PokerAction(t,i,"draw");else if(Cards_tables[t].street[i]<Cards_tables[t].current)Cards_PokerAction(t,i,"fold");else Cards_PokerAction(t,i,"call");}}
}
