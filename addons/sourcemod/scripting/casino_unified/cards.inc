public bool Cards_SeatCameraTrace(int e,int mask,any c){
    if(e>0&&e<=MaxClients)return false;
    if(e==Cards_Entity(Cards_seatVisual[c])||e==Cards_Entity(Cards_seatCamera[c])||e==Cards_Entity(Cards_seatBody[c]))return false;
    return e!=Cards_Entity(Cards_machines[Cards_seatSlot[c]-1].chair);
}
bool Cards_SeatViewUpdate(int c){
    int camera=Cards_Entity(Cards_seatCamera[c]);if(camera==-1||Cards_Entity(Cards_seatVisual[c])==-1)return false;
    SetEntProp(c,Prop_Send,"m_bCustomModelVisibleToSelf",Cards_seatThird[c]?1:0);
    float origin[3],angles[3],look[3],head[3],pos[3];
    origin=Cards_machines[Cards_seatSlot[c]-1].chairOrigin;GetClientEyeAngles(c,angles);GetAngleVectors(angles,look,NULL_VECTOR,NULL_VECTOR);
    head=origin;head[2]+=Cards_seatEyes[view_as<int>(TF2_GetPlayerClass(c))];pos=head;
#if defined CASINO_NATIVE_FIRSTPERSON
    int view=Cards_seatThird[c]?camera:c;
    float eyeOffset[3];eyeOffset[2]=Cards_seatEyes[view_as<int>(TF2_GetPlayerClass(c))];SetEntPropVector(c,Prop_Data,"m_vecViewOffset",eyeOffset);
    if(GetEntPropEnt(c,Prop_Data,"m_hViewEntity")!=view){SetEntPropEnt(c,Prop_Data,"m_hViewEntity",view);SetClientViewEntity(c,view);}
#endif
    if(Cards_seatThird[c])for(int i=0;i<3;i++)pos[i]-=look[i]*85.0;
    float mins[3]={-3.0,-3.0,-3.0},maxs[3]={3.0,3.0,3.0};
    Handle tr=TR_TraceHullFilterEx(head,pos,mins,maxs,MASK_SOLID,Cards_SeatCameraTrace,c);
    if(TR_StartSolid(tr)||TR_AllSolid(tr))pos=head;
    else if(TR_DidHit(tr)){float f=TR_GetFraction(tr)-0.01;if(f<0.0)f=0.0;for(int i=0;i<3;i++)pos[i]=head[i]+(pos[i]-head[i])*f;}
    delete tr;Cards_seatViewPosition[c]=pos;
    // Constant local offset in free space; only wall clipping changes arm length.
    float local[3];local[0]=-GetVectorDistance(head,pos);
    int parity=GetEntProp(camera,Prop_Send,"m_ubInterpolationFrame");
    TeleportEntity(camera,local,NULL_VECTOR,NULL_VECTOR);SetEntProp(camera,Prop_Send,"m_ubInterpolationFrame",parity);
    if(!IsFakeClient(c)&&GetGameTime()>=Cards_seatCrosshairAt[c]){
        Cards_seatCrosshairAt[c]=GetGameTime()+0.1;
        SetHudTextParams(-1.0,0.49,0.25,150,255,170,255,0,0.0,0.0,0.0);ShowSyncHudText(c,Cards_seatCrosshair,"+");
    }
    return true;
}
