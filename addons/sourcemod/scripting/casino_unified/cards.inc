int Cards_Aim(int c,float distance){float p[3],a[3],v[3],end[3];GetClientEyePosition(c,p);GetClientEyeAngles(c,a);GetAngleVectors(a,v,NULL_VECTOR,NULL_VECTOR);for(int i=0;i<3;i++)end[i]=p[i]+v[i]*distance;Handle tr=TR_TraceRayFilterEx(p,end,MASK_SOLID,RayType_EndPoint,Cards_SeatAimTrace,c);int e=TR_DidHit(tr)?TR_GetEntityIndex(tr):-1;delete tr;return e;}
void Cards_SpawnTable(int c,int kind){
    if(kind<0||kind>2)return;
    if(!Cards_ready||!Cards_Player(c)||Cards_seatSlot[c]){PrintToChat(c,"[카드] 모델 준비 및 살아 있는 비탑승 상태가 필요합니다.");return;}
    int t=-1;for(int i=0;i<Cards_TABLES;i++)if(Cards_Entity(Cards_tables[i].body)==-1){t=i;break;}
    if(t<0||GetEntityCount()>GetMaxEntities()-160){PrintToChat(c,"[카드] 테이블 또는 엔티티 한도입니다.");return;}
    float eye[3],a[3],p[3],n[3];GetClientEyePosition(c,eye);GetClientEyeAngles(c,a);
    Handle tr=TR_TraceRayFilterEx(eye,a,MASK_SOLID,RayType_Infinite,Cards_SeatAimTrace,c);
    bool hit=TR_DidHit(tr)&&!TR_StartSolid(tr);TR_GetEndPosition(p,tr);TR_GetPlaneNormal(tr,n);delete tr;
    if(!hit||n[2]<0.9||GetVectorDistance(eye,p)>800.0){PrintToChat(c,"[카드] 가까운 평평한 바닥을 바라보세요.");return;}
    // Check the entire installation volume before creating any entities.
    float mins[3]={-180.0,-135.0,2.0},maxs[3]={180.0,135.0,95.0};
    tr=TR_TraceHullFilterEx(p,p,mins,maxs,MASK_SOLID,Cards_SeatAimTrace,c);bool blocked=TR_DidHit(tr)||TR_StartSolid(tr);delete tr;
    if(blocked){PrintToChat(c,"[카드] 테이블과 여섯 의자를 설치할 공간이 부족합니다.");return;}
    Cards_tables[t].kind=kind;Cards_tables[t].origin=p;Cards_tables[t].yaw=0.0;Cards_tables[t].dealer=5;
    Cards_tables[t].body=Cards_Prop(Cards_models[kind==0?0:1],true);if(Cards_Entity(Cards_tables[t].body)==-1)return;
    float angle[3];angle[1]=-90.0;TeleportEntity(Cards_Entity(Cards_tables[t].body),p,angle,NULL_VECTOR);
    for(int i=0;i<6;i++){
        int s=t*6+i;float rad=DegToRad(30.0+float(i)*60.0),cp[3],end[3],normal[3];cp=p;
        float offset[3];offset[0]=Cosine(rad)*(kind==0?130.0:150.0);offset[1]=Sine(rad)*105.0;
        float distance=GetVectorLength(offset);ScaleVector(offset,(distance-20.0)/distance);
        AddVectors(cp,offset,cp);cp[2]+=32.0;end=cp;end[2]-=64.0;
        tr=TR_TraceRayFilterEx(cp,end,MASK_SOLID,RayType_EndPoint,Cards_TraceWorld);
        bool floor=TR_DidHit(tr)&&!TR_StartSolid(tr);TR_GetEndPosition(cp,tr);TR_GetPlaneNormal(tr,normal);delete tr;
        if(!floor||normal[2]<0.9||FloatAbs(cp[2]-p[2])>16.0){Cards_RemoveTable(t);PrintToChat(c,"[카드] 의자 아래 바닥이 없어 설치를 취소했습니다.");return;}
        Cards_machines[s].origin=cp;Cards_machines[s].chairOrigin=cp;
        Cards_machines[s].yaw=RadToDeg(ArcTangent2(cp[1]-p[1],cp[0]-p[0]));
        Cards_machines[s].chair=Cards_Prop(Cards_CHAIR_MODEL,true);
        if(Cards_Entity(Cards_machines[s].chair)==-1){Cards_RemoveTable(t);return;}
        angle[1]=Cards_machines[s].yaw+90.0;TeleportEntity(Cards_Entity(Cards_machines[s].chair),cp,angle,NULL_VECTOR);
    }
    PrintToChat(c,"[카드] %s 설치 완료. 테이블/의자를 보고 E 또는 메딕 호출: 착석 / Ctrl: 하차",kind==0?"블랙잭":"포커");
}
void Cards_RemoveTable(int t){
    Cards_ViewClear(t);
    if(Cards_tables[t].phase){for(int i=0;i<6;i++)Cards_AddChips(Cards_Owner(t,i),Cards_tables[t].paid[i]);Cards_tables[t].phase=0;}
    for(int s=t*6;s<t*6+6;s++){
        int c=Cards_Seated(s);if(c){if(Cards_blackjack[c].active){Cards_AddChips(c,Cards_blackjack[c].wager);Cards_blackjack[c].active=false;}Cards_SeatStop(c,false);}
        int e=Cards_Entity(Cards_machines[s].chair);if(e!=-1)RemoveEntity(e);Cards_Machine blank;Cards_machines[s]=blank;
    }
    int e=Cards_Entity(Cards_tables[t].body);if(e!=-1)RemoveEntity(e);Cards_Table blank;Cards_tables[t]=blank;Cards_tables[t].dealer=5;
}
