        if(t>=0){Cards_RemoveTable(t);PrintToChat(c,"[카드] 테이블·의자 제거. 진행 중 게임은 취소·환불했습니다.");}else PrintToChat(c,"[카드] 테이블 또는 의자를 바라보세요.");
    }else Cards_SpawnTable(c,StringToInt(key));
