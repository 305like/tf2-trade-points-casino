public bool Diamond_SeatCameraTrace(int e,int mask,any c){
    if(e>0&&e<=MaxClients)return false;
    if(e==Diamond_Entity(Diamond_seatVisual[c])||e==Diamond_Entity(Diamond_seatCamera[c])||e==Diamond_Entity(Diamond_seatBody[c]))return false;
    return e!=Diamond_Entity(Diamond_machines[Diamond_seatSlot[c]-1].chair);
}
bool Diamond_SeatViewUpdate(int c){
    int camera=Diamond_Entity(Diamond_seatCamera[c]);if(camera==-1||Diamond_Entity(Diamond_seatVisual[c])==-1)return false;
    SetEntProp(c,Prop_Send,"m_bCustomModelVisibleToSelf",Diamond_seatThird[c]?1:0);
    float origin[3],angles[3],look[3],head[3],pos[3];
    origin=Diamond_machines[Diamond_seatSlot[c]-1].chairOrigin;GetClientEyeAngles(c,angles);GetAngleVectors(angles,look,NULL_VECTOR,NULL_VECTOR);
    head=origin;head[2]+=Diamond_seatEyes[view_as<int>(TF2_GetPlayerClass(c))];pos=head;
#if defined CASINO_NATIVE_FIRSTPERSON
    int view=Diamond_seatThird[c]?camera:c;
    float eyeOffset[3];eyeOffset[2]=Diamond_seatEyes[view_as<int>(TF2_GetPlayerClass(c))];SetEntPropVector(c,Prop_Data,"m_vecViewOffset",eyeOffset);
    if(GetEntPropEnt(c,Prop_Data,"m_hViewEntity")!=view){SetEntPropEnt(c,Prop_Data,"m_hViewEntity",view);SetClientViewEntity(c,view);}
#endif
    if(Diamond_seatThird[c])for(int i=0;i<3;i++)pos[i]-=look[i]*85.0;
    float mins[3]={-3.0,-3.0,-3.0},maxs[3]={3.0,3.0,3.0};
    Handle tr=TR_TraceHullFilterEx(head,pos,mins,maxs,MASK_SOLID,Diamond_SeatCameraTrace,c);
    if(TR_StartSolid(tr)||TR_AllSolid(tr))pos=head;
    else if(TR_DidHit(tr)){float f=TR_GetFraction(tr)-0.01;if(f<0.0)f=0.0;for(int i=0;i<3;i++)pos[i]=head[i]+(pos[i]-head[i])*f;}
    delete tr;Diamond_seatViewPosition[c]=pos;
    // Constant local offset in free space; only wall clipping changes arm length.
    float local[3];local[0]=-GetVectorDistance(head,pos);
    int parity=GetEntProp(camera,Prop_Send,"m_ubInterpolationFrame");
    TeleportEntity(camera,local,NULL_VECTOR,NULL_VECTOR);SetEntProp(camera,Prop_Send,"m_ubInterpolationFrame",parity);
    if(!IsFakeClient(c)&&GetGameTime()>=Diamond_seatCrosshairAt[c]){
        Diamond_seatCrosshairAt[c]=GetGameTime()+0.1;
        SetHudTextParams(-1.0,0.49,0.25,150,255,170,255,0,0.0,0.0,0.0);ShowSyncHudText(c,Diamond_seatCrosshair,"+");
    }
    return true;
}
void Diamond_SeatAim(int c,float eye[3],float angles[3]){
