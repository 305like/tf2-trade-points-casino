void Diamond_SeatsFrame(){
    for(int c=1;c<=MaxClients;c++)if(Diamond_seatSlot[c]){
        if(!Diamond_Player(c)||Diamond_Entity(Diamond_machines[Diamond_seatSlot[c]-1].chair)==-1){Diamond_SeatStop(c,false);continue;}
