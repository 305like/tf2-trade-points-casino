void Diamond_SeatViewStop(int c){
    int camera=Diamond_Entity(Diamond_seatCamera[c]),visual=Diamond_Entity(Diamond_seatVisual[c]);
    if(camera!=-1&&GetEntPropEnt(c,Prop_Data,"m_hViewEntity")==camera){SetEntPropEnt(c,Prop_Data,"m_hViewEntity",c);SetClientViewEntity(c,c);}
    if(Diamond_seatCosmetics[c]!=null){
        for(int i=0;i<Diamond_seatCosmetics[c].Length;i++){
            int row[3];Diamond_seatCosmetics[c].GetArray(i,row);int e=Diamond_Entity(row[0]),clone=Diamond_Entity(row[2]);
            if(e!=-1&&GetEntityRenderMode(e)==RENDER_NONE)SetEntityRenderMode(e,view_as<RenderMode>(row[1]));
            if(clone!=-1)RemoveEntity(clone);
        }
        delete Diamond_seatCosmetics[c];
    }
    if(camera!=-1)RemoveEntity(camera);if(visual!=-1)RemoveEntity(visual);
    Diamond_seatCamera[c]=Diamond_seatVisual[c]=INVALID_ENT_REFERENCE;
    SetEntityRenderMode(c,Diamond_seatRender[c]);
    Diamond_SeatReturnWeapons(c,!Diamond_seatDiscard[c]&&Diamond_Player(c)&&view_as<int>(TF2_GetPlayerClass(c))==Diamond_seatClass[c]&&GetClientTeam(c)==Diamond_seatTeam[c]);
    if(!IsFakeClient(c))ClearSyncHud(c,Diamond_seatCrosshair);
}
void Diamond_SeatViewRestoreModel(int c){
    for(int i=0;i<sizeof(Diamond_seatViewProps);i++)SetEntProp(c,Prop_Send,Diamond_seatViewProps[i],Diamond_seatViewSaved[c][i]);
    SetEntPropVector(c,Prop_Send,"m_vecCustomModelOffset",Diamond_seatOffset[c]);SetEntPropVector(c,Prop_Send,"m_angCustomModelRotation",Diamond_seatRotation[c]);
    SetEntPropFloat(c,Prop_Send,"m_flCycle",Diamond_seatCycle[c]);SetEntPropFloat(c,Prop_Send,"m_flPlaybackRate",Diamond_seatPlayback[c]);
}
bool Diamond_SeatCameraVerify(){
    int ref=Diamond_Prop(Diamond_SEAT_CAMERA_RIG),e=Diamond_Entity(ref);if(e==-1)return false;
    bool ok=LookupEntityAttachment(e,"local_camera")>0;RemoveEntity(e);
    // Slot zero is never a player: exercise the same clone path without mounting anyone.
    int saved=Diamond_seatVisual[0];Diamond_seatVisual[0]=Diamond_Prop("models/casino_seats/v2/scout.mdl");
    int parent=Diamond_Entity(Diamond_seatVisual[0]),copy=Diamond_SeatClone(0,"models/casino_seats/v2/scout.mdl",0,0),child=Diamond_Entity(copy);
    bool merge=parent!=-1&&child!=-1;
    if(merge)merge=GetEntityMoveType(child)==MOVETYPE_NONE
        &&GetEntPropEnt(child,Prop_Data,"m_hMoveParent")==parent
        &&(GetEntProp(child,Prop_Send,"m_fEffects")&1)!=0;
    if(child!=-1)RemoveEntity(child);if(parent!=-1)RemoveEntity(parent);Diamond_seatVisual[0]=saved;
    for(int player=1;player<=MaxClients;player++)if(Diamond_SeatCameraTrace(player,MASK_SOLID,0))ok=false;
    LogMessage("Seat clone verify %s: bone-merge follow requirements",merge?"PASS":"FAIL");
    if(!merge)ok=false;
    // A centered first-person camera must remain at local zero at every angle.
    for(int pitch=-80;pitch<=80;pitch+=40)for(int yaw=-180;yaw<=180;yaw+=45){
        float a[3],look[3],right[3],up[3],delta[3]={24.0,-18.0,-70.0},local[3],world[3];
        a[0]=float(pitch);a[1]=float(yaw);GetAngleVectors(a,look,right,up);
        local[0]=GetVectorDotProduct(delta,look);local[1]=-GetVectorDotProduct(delta,right);local[2]=GetVectorDotProduct(delta,up);
        for(int i=0;i<3;i++)world[i]=local[0]*look[i]-local[1]*right[i]+local[2]*up[i];
        if(GetVectorDistance(delta,world)>0.001)ok=false;
        float head[3]={0.0,0.0,80.0},pos[3];pos=head;
        if(GetVectorDistance(head,pos)!=0.0)ok=false;
        for(int i=0;i<3;i++)pos[i]=head[i]-look[i]*85.0;
        if(FloatAbs(GetVectorDistance(head,pos)-85.0)>0.001)ok=false;
    }
    return ok;
}


bool Diamond_SeatStoreWeapons(int c)
{
    // Remove from inventory but retain the original entities and item attributes.
    int slots=GetEntPropArraySize(c,Prop_Send,"m_hMyWeapons");
    for (int i;i<slots;i++)
    {
        int weapon=GetEntPropEnt(c,Prop_Send,"m_hMyWeapons",i);
        if (weapon<=MaxClients || !IsValidEntity(weapon)) continue;
        int entry[4]; entry[0]=EntIndexToEntRef(weapon);
        entry[1]=GetEntProp(weapon,Prop_Send,"m_iClip1");
        entry[2]=GetEntProp(weapon,Prop_Send,"m_iClip2");
        entry[3]=GetEntProp(weapon,Prop_Send,"m_fEffects");
        if (!RemovePlayerItem(c,weapon)) return false;
        Diamond_seatWeapons[c].PushArray(entry);
        weapon=EntRefToEntIndex(entry[0]);
        if (weapon<=MaxClients || !IsValidEntity(weapon)) return false;
        SetEntProp(weapon,Prop_Send,"m_fEffects",entry[3] | 32);
        SDKHook(weapon,SDKHook_Touch,Diamond_SeatBlockPickup);
    }
    return GetEntPropEnt(c,Prop_Send,"m_hActiveWeapon")<=MaxClients;
}
public Action Diamond_SeatBlockPickup(int weapon,int other) { return Plugin_Handled; }
void Diamond_SeatReturnWeapons(int c,bool restore)
{
    if (Diamond_seatWeapons[c]==null) return;
    int ammo[64],count;
    if (restore)
    {
        count=GetEntPropArraySize(c,Prop_Send,"m_iAmmo");
        if (count>sizeof(ammo)) { LogError("Ammo array exceeds restore capacity"); restore=false; count=0; }
        for (int i;i<count;i++) ammo[i]=GetEntProp(c,Prop_Send,"m_iAmmo",_,i);
    }
    for (int i;i<Diamond_seatWeapons[c].Length;i++)
    {
        int entry[4]; Diamond_seatWeapons[c].GetArray(i,entry);
        int weapon=EntRefToEntIndex(entry[0]);
        if (weapon<=MaxClients || !IsValidEntity(weapon)) continue;
        SDKUnhook(weapon,SDKHook_Touch,Diamond_SeatBlockPickup);
        int owner=GetEntPropEnt(weapon,Prop_Send,"m_hOwnerEntity");
        if (owner>0 && owner!=c) { LogError("Stored weapon changed owner: %d",weapon); continue; }
        if (!restore) { RemoveEntity(weapon); continue; }
        EquipPlayerWeapon(c,weapon);
        weapon=EntRefToEntIndex(entry[0]);
        if (weapon<=MaxClients || !IsValidEntity(weapon) || GetEntPropEnt(weapon,Prop_Send,"m_hOwnerEntity")!=c)
        { LogError("Stored weapon restore failed for client %d",c); continue; }
        SetEntProp(weapon,Prop_Send,"m_iClip1",entry[1]);
        SetEntProp(weapon,Prop_Send,"m_iClip2",entry[2]);
        SetEntProp(weapon,Prop_Send,"m_fEffects",entry[3]);
    }
    delete Diamond_seatWeapons[c];
    for (int i;i<count;i++) SetEntProp(c,Prop_Send,"m_iAmmo",ammo[i],_,i);
    int active=EntRefToEntIndex(Diamond_seatWeaponActive[c]);
    if (restore && active>MaxClients && IsValidEntity(active) && GetEntPropEnt(active,Prop_Send,"m_hOwnerEntity")==c)
    {
        char classname[64]; GetEntityClassname(active,classname,sizeof(classname));
        FakeClientCommand(c,"use %s",classname);
    }
}

// Installation UI retained from slot_machine_test; machines are now Tower Slots.
int Diamond_installCount[MAXPLAYERS+1],Diamond_inputMode[MAXPLAYERS+1];
int Diamond_testOutcome[MAXPLAYERS+1]; // Zero = normal; selected category + 1 is consumed once.
float Diamond_installSpacing[MAXPLAYERS+1];
ArrayList Diamond_slotMenus;
bool Diamond_slotEnding;
bool Diamond_SlotAdmin(int c){return c>0&&IsClientInGame(c)&&(GetUserFlagBits(c)&(ADMFLAG_GENERIC|ADMFLAG_ROOT))!=0&&CheckCommandAccess(c,"sm_slotmachine",ADMFLAG_GENERIC);}
void Diamond_SlotSetupInit(){
    Diamond_slotMenus=new ArrayList();
    RegAdminCmd("sm_slotmachine",Diamond_SetupCommand,ADMFLAG_GENERIC);
    RegAdminCmd("sm_slotmachine_status",Diamond_Status,ADMFLAG_GENERIC);
    AddCommandListener(Diamond_SlotChat,"say");AddCommandListener(Diamond_SlotChat,"say_team");
    int n;
    if(!Diamond_ParseSetting("5",2,n)||n!=5||Diamond_ParseSetting("4",2,n)||Diamond_ParseSetting("2001",2,n)
       ||!Diamond_ParseSetting("64",1,n)||Diamond_ParseSetting("65",1,n)||Diamond_ParseSetting("5x",2,n)
       ||FloatAbs(Diamond_RowOffset(0,2,5.0)+2.5)>0.001||FloatAbs(Diamond_RowOffset(1,2,5.0)-2.5)>0.001)
       SetFailState("Slot setup bounds/spacing selftest failed");
}
public Action Diamond_SlotChat(int c,const char[] command,int argc)
{
    if(Diamond_slotEnding)return Plugin_Continue;
    char text[128];GetCmdArgString(text,sizeof(text));StripQuotes(text);TrimString(text);
    if(c<1 || !IsClientInGame(c)) return Plugin_Continue;
    if(StrEqual(text,"!슬롯머신") || StrEqual(text,"/슬롯머신")) {
        if(Diamond_SlotAdmin(c)) Diamond_SetupCommand(c,0);
        else PrintToChat(c,"[슬롯] 어드민 전용입니다.");
        return Plugin_Handled;
    }
    if(Diamond_inputMode[c]!=0) {
        if(!Diamond_SlotAdmin(c)) {Diamond_inputMode[c]=0;return Plugin_Continue;}
        if(StrEqual(text,"!취소") || StrEqual(text,"취소")) {Diamond_inputMode[c]=0;Diamond_ShowSetup(c);return Plugin_Handled;}
        if(text[0]=='!' || text[0]=='/') {Diamond_inputMode[c]=0;return Plugin_Continue;}
        int number;
        if(!Diamond_ParseSetting(text,Diamond_inputMode[c],number)) {PrintToChat(c,"[슬롯] 개수 1~64 / 중심 간격 5~2000의 정수를 입력하세요. 취소: !취소");return Plugin_Handled;}
        if(Diamond_inputMode[c]==1) Diamond_installCount[c]=number;else Diamond_installSpacing[c]=float(number);
        Diamond_inputMode[c]=0;Diamond_ShowSetup(c);return Plugin_Handled;
    }
    return Plugin_Continue;
}
bool Diamond_ParseSetting(const char[] text,int mode,int &number)
{
    int length=strlen(text);if(length==0 || length>4) return false;
    for(int i=0;i<length;i++) if(text[i]<'0' || text[i]>'9') return false;
    number=StringToInt(text);return mode==1?(number>=1 && number<=64):(number>=5 && number<=2000);
}
public Action Diamond_SetupCommand(int c,int args)
{
    if(!Diamond_slotEnding && Diamond_SlotAdmin(c)) {Diamond_inputMode[c]=0;Diamond_ShowSetup(c);}return Plugin_Handled;
}
void Diamond_SlotMenuEnd(Menu menu){
    if(Diamond_slotEnding)return;
    int index=Diamond_slotMenus.FindValue(menu);
    if(index==-1)return;
    Diamond_slotMenus.Erase(index);delete menu;
}
void Diamond_SlotMenusShutdown(){
    Diamond_slotEnding=true;
    // Destroy while callbacks are still alive; End callbacks must not delete twice.
    while(Diamond_slotMenus!=null && Diamond_slotMenus.Length>0){
        int last=Diamond_slotMenus.Length-1;Menu menu=view_as<Menu>(Diamond_slotMenus.Get(last));
        Diamond_slotMenus.Erase(last);delete menu;
    }
    delete Diamond_slotMenus;
}
void Diamond_ShowSetup(int c)
{
    if(Diamond_slotEnding||!Diamond_SlotAdmin(c))return;
    if(Diamond_installCount[c]==0) {Diamond_installCount[c]=1;Diamond_installSpacing[c]=32.0;}
    Menu menu=new Menu(Diamond_SetupHandler);Diamond_slotMenus.Push(menu);menu.SetTitle("도박 기계 설치 (중앙 기준 한 줄)");
    menu.AddItem("kind","설치할 기계: 다이아몬드 슬롯머신");
    char label[96];Format(label,sizeof(label),"설치 개수: %d대",Diamond_installCount[c]);menu.AddItem("count",label);
    Format(label,sizeof(label),"중심 간격: %.0f 유닛",Diamond_installSpacing[c]);menu.AddItem("spacing",label);
    menu.AddItem("spawn","설정한 개수로 묶음 설치");menu.AddItem("delete","바라보는 슬롯머신 삭제");
    menu.AddItem("all","슬롯머신 모두 삭제");menu.AddItem("test","확률 조작 테스트 (내 다음 1회)");menu.Display(c,MENU_TIME_FOREVER);
}
public int Diamond_SetupHandler(Menu menu,MenuAction action,int c,int item)
{
    if(action==MenuAction_End) {Diamond_SlotMenuEnd(menu);return 0;}
    if(Diamond_slotEnding)return 0;
    if(action!=MenuAction_Select || !Diamond_SlotAdmin(c)) return 0;
    char key[16];menu.GetItem(item,key,sizeof(key));
    if(StrEqual(key,"kind")) {Diamond_ShowMachineKind(c);
    } else if(StrEqual(key,"count") || StrEqual(key,"spacing")) {
        Diamond_inputMode[c]=StrEqual(key,"count")?1:2;
        PrintToChat(c,Diamond_inputMode[c]==1?"[슬롯] 설치 개수 1~64를 채팅에 입력하세요. 취소: !취소":"[슬롯] 중심 간격 5~2000 유닛을 채팅에 입력하세요. 취소: !취소");
    } else if(StrEqual(key,"test")) {Diamond_ShowTest(c);
    } else if(StrEqual(key,"all")) {
        Menu confirm=new Menu(Diamond_ConfirmHandler);Diamond_slotMenus.Push(confirm);confirm.SetTitle("이 플러그인의 슬롯머신을 모두 삭제할까요?");
        confirm.AddItem("yes","모두 삭제");confirm.AddItem("no","취소");confirm.Display(c,MENU_TIME_FOREVER);
    } else {
        if(StrEqual(key,"spawn")) Diamond_SpawnBatch(c,Diamond_installCount[c],Diamond_installSpacing[c]);else Diamond_DeleteCommand(c,0);
        Diamond_ShowSetup(c);
    }
    return 0;
}
public int Diamond_ConfirmHandler(Menu menu,MenuAction action,int c,int item)
{
    if(action==MenuAction_End) {Diamond_SlotMenuEnd(menu);return 0;}
    if(Diamond_slotEnding)return 0;
    if(action==MenuAction_Select && Diamond_SlotAdmin(c)) {
        if(item==0) {int count;for(int s=0;s<Diamond_COUNT;s++) {if((Diamond_Entity(Diamond_machines[s].body)!=-1)) count++;Diamond_Remove(s);}PrintToChat(c,"[슬롯] %d대 삭제 완료.",count);}
        Diamond_ShowSetup(c);
    }
    return 0;
}
float Diamond_RowOffset(int index,int count,float spacing) {return (float(index)-float(count-1)*0.5)*spacing;}
