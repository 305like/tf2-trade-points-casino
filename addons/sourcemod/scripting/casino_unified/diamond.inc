void Diamond_ClearCelebration(int s){
    for(int i=0;i<Diamond_WIN_FX_COUNT;i++){
        int e=Diamond_Entity(Diamond_machines[s].celebration[i]);if(e!=-1)RemoveEntity(e);
        Diamond_machines[s].celebration[i]=INVALID_ENT_REFERENCE;
    }
    Diamond_machines[s].celebrationUntil=0.0;
    Diamond_machines[s].celebrationCoinUntil=Diamond_machines[s].celebrationRepeat=0.0;Diamond_machines[s].celebrationJackpot=false;
    Diamond_machines[s].celebrationAlternate=false;
}
void Diamond_WinEmitter(int s,int index,int effect,float yaw){
    int old=Diamond_Entity(Diamond_machines[s].celebration[index]);if(old!=-1)RemoveEntity(old);
    Diamond_machines[s].celebration[index]=INVALID_ENT_REFERENCE;
    if(GetEntityCount()>=GetMaxEntities()-32){LogError("Slot effect skipped: entity reserve");return;}
    int e=CreateEntityByName("info_particle_system");if(e==-1){LogError("Slot celebration creation failed");return;}
    Diamond_machines[s].celebration[index]=EntIndexToEntRef(e);
    DispatchKeyValue(e,"effect_name",Diamond_winParticles[effect]);DispatchKeyValue(e,"start_active","0");
    char target[64];Format(target,sizeof(target),"tower_win_%d_%d",e,GetGameTickCount());
    DispatchKeyValue(e,"targetname",target);DispatchKeyValue(e,"cpoint1",target);
    float p[3],a[3];Diamond_WorldPoint(s,0.0,0.0,30.0,p);
    p[0]+=Cosine(DegToRad(yaw))*12.0;p[1]+=Sine(DegToRad(yaw))*12.0;
    // Split-money velocity uses local Z at CP1; tilt that axis toward the rider.
    a[0]=effect==0?65.0:0.0;a[1]=yaw;
    TeleportEntity(e,p,a,NULL_VECTOR);
    if(!DispatchSpawn(e)){RemoveEntity(e);Diamond_machines[s].celebration[index]=INVALID_ENT_REFERENCE;return;}
    ActivateEntity(e);AcceptEntityInput(e,"Start");
}
void Diamond_Celebrate(int s,int category){
    if(category<0||category>=8)return;
    if(category!=0&&Diamond_machines[s].celebrationJackpot&&GetGameTime()<Diamond_machines[s].celebrationUntil)return;
    Diamond_ClearCelebration(s);
    Diamond_machines[s].celebrationYaw=Diamond_machines[s].yaw;
    int c=GetClientOfUserId(Diamond_machines[s].user);
    if(Diamond_Player(c)){
        float p[3],rider[3],delta[3],a[3];Diamond_WorldPoint(s,0.0,0.0,30.0,p);GetClientAbsOrigin(c,rider);
        MakeVectorFromPoints(p,rider,delta);GetVectorAngles(delta,a);Diamond_machines[s].celebrationYaw=a[1];
    }
    Diamond_machines[s].celebrationJackpot=category==0;
    if(category==0){
        for(int direction=0;direction<5;direction++){
            float yaw=Diamond_machines[s].celebrationYaw+float(direction)*72.0;
            for(int effect=1;effect<=3;effect++)Diamond_WinEmitter(s,direction*4+effect-1,effect,yaw);
        }
        Diamond_machines[s].celebrationUntil=GetGameTime()+Diamond_JACKPOT_SOUND_SECONDS-Diamond_BIG_WIN_LEAD_SECONDS+Diamond_BIG_WIN_SECONDS+Diamond_COIN_DUMP_SECONDS;
        Diamond_machines[s].celebrationRepeat=GetGameTime()+2.25;
    }else{
        Diamond_WinEmitter(s,0,0,Diamond_machines[s].celebrationYaw);Diamond_WinEmitter(s,1,1,Diamond_machines[s].celebrationYaw);
        Diamond_machines[s].celebrationCoinUntil=GetGameTime()+1.0;Diamond_machines[s].celebrationUntil=GetGameTime()+3.0;
    }
}
void Diamond_UpdateCelebration(int s,float now){
    if(Diamond_machines[s].celebrationUntil<=0.0)return;
    if(now>=Diamond_machines[s].celebrationUntil){Diamond_ClearCelebration(s);return;}
    if(Diamond_machines[s].celebrationCoinUntil>0.0&&now>=Diamond_machines[s].celebrationCoinUntil){
        int e=Diamond_Entity(Diamond_machines[s].celebration[1]);if(e!=-1)RemoveEntity(e);
        Diamond_machines[s].celebration[1]=INVALID_ENT_REFERENCE;Diamond_machines[s].celebrationCoinUntil=0.0;
    }
    if(Diamond_machines[s].celebrationJackpot&&now>=Diamond_machines[s].celebrationRepeat){
        Diamond_machines[s].celebrationAlternate=!Diamond_machines[s].celebrationAlternate;
        for(int direction=0;direction<5;direction++){
            float yaw=Diamond_machines[s].celebrationYaw+float(direction)*72.0;
            Diamond_WinEmitter(s,direction*4+1,2,yaw);
            // Dollars start after 0.7s: overlap two batches to avoid emission gaps.
            Diamond_WinEmitter(s,direction*4+(Diamond_machines[s].celebrationAlternate?3:2),3,yaw);
        }
        Diamond_machines[s].celebrationRepeat=now+2.25;
    }
}
int Diamond_Choose() {
    int total;for(int i=0;i<9;i++)total+=Diamond_weights[i].IntValue;
    if(total<=0)return 8;
    int n=GetRandomInt(1,total);for(int i=0;i<9;i++){n-=Diamond_weights[i].IntValue;if(n<=0)return i;}return 8;
}
int Diamond_WinSound(int category){return category==0?5:(category>=1&&category<=3?4:3);}
int Diamond_SettleReward(int category,int &bank){
    if(category==0){int reward=bank;bank=0;return reward;}
    return category>=1&&category<8?Diamond_payout[category]:0;
}
void Diamond_UpdateAllCounters(){for(int s=0;s<Diamond_COUNT;s++)if(Diamond_Entity(Diamond_machines[s].body)!=-1)Diamond_UpdateCounters(s);}
void Diamond_Start(int s,int c) {
    if(!Diamond_Player(c)||Diamond_seatSlot[c]!=s+1)return;
    if(Diamond_machines[s].busy||GetGameTime()<Diamond_machines[s].readyAt)return;
    if(!Diamond_SlotAdmin(c))Diamond_testOutcome[c]=0;
    bool testing=Diamond_testOutcome[c]>0;
    int deposit=(Diamond_machines[s].bet+1)/2;
    if(testing)deposit=0;
    if(Diamond_sharedPool.IntValue>99999999-deposit){PrintToChat(c,"[타워슬롯] 테스트 누적 표시 한도에 도달했습니다.");return;}
    Diamond_sharedPool.IntValue+=deposit;Diamond_UpdateAllCounters();
    int result=testing?Diamond_testOutcome[c]-1:Diamond_Choose();Diamond_testOutcome[c]=0;Diamond_machines[s].testSpin=testing;Diamond_machines[s].category=result;
    if(testing)PrintToChat(c,"[슬롯 테스트] 지정 결과 적용. 이번 회전은 공용 누적금에 영향을 주지 않습니다.");
    if(result<6){for(int i=0;i<3;i++)Diamond_machines[s].symbol[i]=result;}
    else {
        for(int i=0;i<3;i++)Diamond_machines[s].symbol[i]=GetRandomInt(1,5);
        if(result==6){int other=GetRandomInt(0,2);for(int i=0;i<3;i++)if(i!=other)Diamond_machines[s].symbol[i]=0;}
        else if(result==7)Diamond_machines[s].symbol[GetRandomInt(0,2)]=0;
        else if(Diamond_machines[s].symbol[0]==Diamond_machines[s].symbol[1]&&Diamond_machines[s].symbol[1]==Diamond_machines[s].symbol[2])Diamond_machines[s].symbol[2]=Diamond_machines[s].symbol[2]%5+1;
    }
    Diamond_machines[s].user=GetClientUserId(c);Diamond_machines[s].start=GetGameTime();Diamond_machines[s].stopped=0;Diamond_machines[s].busy=true;Diamond_machines[s].spinning=false;
    Diamond_UpdateCounters(s);
    Diamond_Animate(Diamond_machines[s].body,"leverpull");Diamond_Sound(s,0);
    LogMessage("Tower spin start slot=%d user=%d bet=%d deposit=%d jackpot=%d",s,Diamond_machines[s].user,Diamond_machines[s].bet,deposit,Diamond_sharedPool.IntValue);
}
public bool Diamond_TraceObstacles(int e,int mask,any s) {
    if(e>0&&e<=MaxClients)return false;
    if(e==Diamond_Entity(Diamond_machines[s].body))return false;
    if(e==Diamond_Entity(Diamond_machines[s].chair))return false;
    if(e==Diamond_Entity(Diamond_machines[s].highlight))return false;
    for(int i=0;i<3;i++)if(e==Diamond_Entity(Diamond_machines[s].reel[i]))return false;
    for(int i=0;i<9;i++)if(e==Diamond_Entity(Diamond_machines[s].digits[i]))return false;
    return true;
}
bool Diamond_Use(int c) {
    if(!Diamond_Player(c)||!Diamond_ready)return false;
    if(!Diamond_seatSlot[c])return Diamond_SeatUse(c);
    float eye[3],angles[3],direction[3];Diamond_SeatAim(c,eye,angles);GetAngleVectors(angles,direction,NULL_VECTOR,NULL_VECTOR);
    int best=-1,action=-1;float closest=120.0;
    for(int s=Diamond_seatSlot[c]-1;s<Diamond_seatSlot[c];s++)if(Diamond_Entity(Diamond_machines[s].body)!=-1) {
        for(int b=0;b<4;b++){
            float p[3],delta[3];
            if(b<3)Diamond_WorldPoint(s,8.0888,5.86025+float(b)*1.92,18.7635,p);
            else Diamond_WorldPoint(s,4.79839,15.0,32.5,p);
            MakeVectorFromPoints(eye,p,delta);float along=GetVectorDotProduct(delta,direction);
            if(along<1.0||along>=closest)continue;
            float radius=(b<3?0.93:4.0)*Diamond_SCALE;
            if(GetVectorLength(delta,true)-along*along>radius*radius)continue;
            // Controls are on the front; do not operate them through the cabinet.
            float rad=DegToRad(Diamond_machines[s].yaw);
            if((eye[0]-p[0])*Cosine(rad)+(eye[1]-p[1])*Sine(rad)<0.0)continue;
            Handle trace=TR_TraceRayFilterEx(eye,p,MASK_SOLID,RayType_EndPoint,Diamond_TraceObstacles,s);
            bool blocked=TR_DidHit(trace);delete trace;if(blocked)continue;
            best=s;action=b;closest=along;
        }
    }
    if(best==-1)return false;
    if(Diamond_machines[best].busy||GetGameTime()<Diamond_machines[best].readyAt)return true;
    if(action<3){Diamond_machines[best].bet=1+action*2;Diamond_UpdateCounters(best);EmitSoundToAll("double_nothing_v3/button_down.wav",Diamond_Entity(Diamond_machines[best].body));Diamond_CasinoHint(c,"베팅 %d 토큰 · 레버를 보고 E: 회전",Diamond_machines[best].bet);}
    else Diamond_Start(best,c);
    return true;
}
public Action Diamond_OnPlayerRunCmd(int c,int &buttons,int &impulse,float vel[3],float angles[3],int &weapon) {
    int old=Diamond_previous[c];bool pressed=(buttons&IN_USE)!=0&&(old&IN_USE)==0;Diamond_previous[c]=buttons;
    if(Diamond_seatSlot[c]){
        if((buttons&IN_DUCK)&&!(old&IN_DUCK)){Diamond_SeatStop(c,true);if(!Diamond_seatSlot[c])return Plugin_Changed;}
        if((buttons&IN_ATTACK3)&&!(old&IN_ATTACK3))Diamond_seatThird[c]=!Diamond_seatThird[c];
        if(pressed)Diamond_Use(c);
        if((buttons&IN_JUMP)&&!(old&IN_JUMP)&&Diamond_ready)Diamond_Start(Diamond_seatSlot[c]-1,c);
        buttons&=~(IN_ATTACK|IN_ATTACK2|IN_ATTACK3|IN_JUMP|IN_DUCK|IN_USE|IN_RELOAD|IN_FORWARD|IN_BACK|IN_MOVELEFT|IN_MOVERIGHT);
        // Raw Ctrl edges were read above; keep the server-side stance crouched.
        buttons|=IN_DUCK;Diamond_SeatPhysicsHold(c);
        vel[0]=vel[1]=vel[2]=0.0;weapon=0;return Plugin_Changed;
    }
    if(pressed&&Diamond_Use(c)){buttons&=~IN_USE;return Plugin_Changed;}return Plugin_Continue;
}
