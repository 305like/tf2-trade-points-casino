}
public bool Diamond_InstallTrace(int e,int mask,any c){return e==0||e>MaxClients;}
void Diamond_SpawnBatch(int c,int count,float spacing)
{
    if(!Diamond_SlotAdmin(c))return;
    if(!Diamond_Player(c) || !Diamond_ready) {ReplyToCommand(c,"[슬롯] 살아 있는 플레이어와 준비된 모델이 필요합니다.");return;}
    float eye[3],ang[3],hit[3],normal[3];GetClientEyePosition(c,eye);GetClientEyeAngles(c,ang);
    Handle tr=TR_TraceRayFilterEx(eye,ang,MASK_SOLID,RayType_Infinite,Diamond_InstallTrace,c);
    bool found=TR_DidHit(tr);TR_GetEndPosition(hit,tr);TR_GetPlaneNormal(tr,normal);delete tr;
    if(!found || normal[2]<0.65 || GetVectorDistance(eye,hit)>800.0) {ReplyToCommand(c,"[슬롯] 800유닛 이내의 평평한 바닥을 바라봐 주세요.");return;}
    int available;for(int s=0;s<Diamond_COUNT;s++) if(!(Diamond_Entity(Diamond_machines[s].body)!=-1)) available++;
    if(count<1 || count>available || GetEntityCount()+count*(16+Diamond_WIN_FX_COUNT)>GetMaxEntities()-32) {ReplyToCommand(c,"[슬롯] 설치 한도 또는 엔티티 여유가 부족합니다. 남은 슬롯: %d",available);return;}
    float positions[Diamond_COUNT][3],r=DegToRad(ang[1]);
    float mins[3]={-30.0,-30.0,1.0},maxs[3]={30.0,30.0,145.0};
    for(int i=0;i<count;i++) {
        float start[3],end[3];start=hit;float offset=Diamond_RowOffset(i,count,spacing);
        start[0]+=Sine(r)*offset;start[1]-=Cosine(r)*offset;start[2]+=50.0;end=start;end[2]-=100.0;
        tr=TR_TraceRayFilterEx(start,end,MASK_SOLID,RayType_EndPoint,Diamond_InstallTrace,c);
        found=TR_DidHit(tr) && !TR_StartSolid(tr);TR_GetEndPosition(positions[i],tr);TR_GetPlaneNormal(tr,normal);delete tr;
        if(!found || normal[2]<0.65 || FloatAbs(positions[i][2]-hit[2])>48.0) {ReplyToCommand(c,"[슬롯] %d번째 위치에 48유닛 이내의 안전한 바닥이 없어 설치를 취소했습니다.",i+1);return;}
        positions[i][2]+=0.1;
        bool blocked=true;float floorZ=positions[i][2];
        for(int step=0;step<=6;step++){
            positions[i][2]=floorZ+float(step)*8.0;
            if(FloatAbs(positions[i][2]-hit[2])>48.1)break;
            tr=TR_TraceHullFilterEx(positions[i],positions[i],mins,maxs,MASK_SOLID,Diamond_InstallTrace,c);
            blocked=TR_StartSolid(tr)||TR_AllSolid(tr)||TR_DidHit(tr);delete tr;if(!blocked)break;
        }
        if(blocked) {ReplyToCommand(c,"[슬롯] %d번째 설치 공간이 부족해 전체 설치를 취소했습니다.",i+1);return;}
    }
    int created[Diamond_COUNT];
    for(int i=0;i<count;i++) {
        created[i]=Diamond_CreateMachine(positions[i],ang[1]+180.0);
        if(created[i]<0) {for(int k=0;k<i;k++) Diamond_Remove(created[k]);ReplyToCommand(c,"[슬롯] 생성 실패. 이번 설치만 되돌렸습니다.");return;}
    }
    PrintToChat(c,"[슬롯] %d대 설치 완료 / 중심 간격 %.0f 유닛. 조작부를 보고 E키를 누르세요.",count,spacing);
}

public bool Diamond_TraceFilter(int ent,int mask,any client){return ent!=client;}
public Action Diamond_DeleteCommand(int c,int args){
    if(!Diamond_Player(c))return Plugin_Handled;
    float eye[3],angles[3];Diamond_SeatAim(c,eye,angles);
    Handle tr=TR_TraceRayFilterEx(eye,angles,MASK_SOLID,RayType_Infinite,Diamond_TraceFilter,c);
    int e=TR_DidHit(tr)?TR_GetEntityIndex(tr):-1;delete tr;
    int found=-1;
    for(int s=0;s<Diamond_COUNT&&e>MaxClients;s++){
        if(e==Diamond_Entity(Diamond_machines[s].body)||e==Diamond_Entity(Diamond_machines[s].chair)||e==Diamond_Entity(Diamond_machines[s].highlight))found=s;
        for(int i=0;i<3;i++)if(e==Diamond_Entity(Diamond_machines[s].reel[i]))found=s;
        for(int i=0;i<9;i++)if(e==Diamond_Entity(Diamond_machines[s].digits[i]))found=s;
        if(found!=-1)break;
    }
    if(found==-1)ReplyToCommand(c,"[슬롯] 삭제할 슬롯머신이나 의자를 바라봐 주세요.");
    else {Diamond_Remove(found);ReplyToCommand(c,"[슬롯] 바라보는 슬롯머신과 의자를 삭제했습니다.");}
    return Plugin_Handled;
}


