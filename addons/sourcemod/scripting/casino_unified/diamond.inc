public void Diamond_OnGameFrame() {
    Diamond_CasinoHintFrame();
    Diamond_SeatsFrame();
    if(!Diamond_ready)return;float now=GetGameTime();
    for(int s=0;s<Diamond_COUNT;s++){
        if(Diamond_machines[s].bigSoundAt>0.0&&now>=Diamond_machines[s].bigSoundAt){Diamond_machines[s].bigSoundAt=0.0;Diamond_Sound(s,7);}
        if(Diamond_machines[s].payoutSoundAt>0.0&&now>=Diamond_machines[s].payoutSoundAt){Diamond_machines[s].payoutSoundAt=0.0;Diamond_Sound(s,6);}
        Diamond_UpdateCelebration(s,now);
    }
    for(int s=0;s<Diamond_COUNT;s++)if(Diamond_machines[s].busy) {
        if(Diamond_Entity(Diamond_machines[s].body)==-1){Diamond_Remove(s);continue;}
        float elapsed=now-Diamond_machines[s].start;
        int lastStop=Diamond_machines[s].symbol[0]==Diamond_machines[s].symbol[1]?5:3;
        if(!Diamond_machines[s].spinning){
            if(elapsed<1.0)continue;
            Diamond_Animate(Diamond_machines[s].body,"idle");
            for(int i=0;i<3;i++){
                char sequence[32];Format(sequence,sizeof(sequence),"r_%d_%d_%d",Diamond_machines[s].previousSymbol[i],Diamond_machines[s].symbol[i],i==2?lastStop:i+1);
                Diamond_Animate(Diamond_machines[s].reel[i],sequence);
            }
            Diamond_machines[s].spinning=true;Diamond_machines[s].start=now;elapsed=0.0;
            Diamond_Sound(s,1);Diamond_machines[s].nextSpinSound=now+0.73;
        }
        if(elapsed<float(lastStop)&&now>=Diamond_machines[s].nextSpinSound){Diamond_Sound(s,1);Diamond_machines[s].nextSpinSound=now+0.73;}
        for(int i=0;i<3;i++) {
            float duration=float(i==2?lastStop:i+1);
            if(elapsed>=duration&&Diamond_machines[s].stopped==i){
                Diamond_machines[s].stopped++;Diamond_machines[s].previousSymbol[i]=Diamond_machines[s].symbol[i];Diamond_Sound(s,2);
            }
        }
        if(Diamond_machines[s].stopped==3) {
            Diamond_machines[s].busy=false;Diamond_UpdateCounters(s);int e=Diamond_Entity(Diamond_machines[s].body);if(e!=-1)StopSound(e,SNDCHAN_STATIC,Diamond_sounds[1]);
            LogMessage("Tower spin end slot=%d category=%d",s,Diamond_machines[s].category);
            int result=Diamond_machines[s].category;
            if(result<8){Diamond_Celebrate(s,result);int c=GetClientOfUserId(Diamond_machines[s].user);
                int bank=Diamond_sharedPool.IntValue;int reward=Diamond_SettleReward(result,bank);
                Diamond_Sound(s,Diamond_WinSound(result));
                if(!Diamond_machines[s].testSpin){Diamond_sharedPool.IntValue=bank;if(result==0)Diamond_UpdateAllCounters();}
                LogMessage("Tower award slot=%d category=%d reward=%d jackpot_remaining=%d",s,result,reward,Diamond_sharedPool.IntValue);
                if(c>0&&IsClientInGame(c))Diamond_CasinoHint(c,"%s / %s / %s\n%d 획득 (테스트)",Diamond_names[Diamond_machines[s].symbol[0]],Diamond_names[Diamond_machines[s].symbol[1]],Diamond_names[Diamond_machines[s].symbol[2]],reward);}
            Diamond_machines[s].readyAt=now+Diamond_RESULT_COOLDOWN;
        }
    }
}
