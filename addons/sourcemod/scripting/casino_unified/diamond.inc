    if(i==7){Diamond_machines[s].payoutSoundAt=GetGameTime()+Diamond_BIG_WIN_SECONDS;Diamond_machines[s].celebrationUntil=GetGameTime()+Diamond_BIG_WIN_SECONDS+Diamond_COIN_DUMP_SECONDS;}
