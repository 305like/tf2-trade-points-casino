public void Diamond_OnMapStart() {
    Diamond_CasinoHintReset();
    Diamond_ready=false;
    for(int c=1;c<=MaxClients;c++)Diamond_testOutcome[c]=0;
    for(int s=0;s<Diamond_COUNT;s++) {Diamond_Machine empty;Diamond_machines[s]=empty;}
    char path[PLATFORM_MAX_PATH],line[PLATFORM_MAX_PATH];
    BuildPath(Path_SM,path,sizeof(path),"configs/tower_slots_downloads.txt");
    File f=OpenFile(path,"r");if(f==null)return;
    bool missing;
    while(f.ReadLine(line,sizeof(line))) {
        TrimString(line);if(!line[0])continue;
        if(!FileExists(line,true)){LogError("Tower slot missing %s",line);missing=true;}
        else AddFileToDownloadsTable(line);
    }
    delete f;if(missing)return;
    if(!PrecacheModel(Diamond_BODY,true)||!PrecacheModel(Diamond_REEL,true)||!PrecacheModel(Diamond_JACKDIGIT,true)||!PrecacheModel(Diamond_CREDITDIGIT,true)||!PrecacheModel(Diamond_PAYHIGHLIGHT,true))return;
    for(int i=0;i<sizeof(Diamond_sounds);i++)if(!PrecacheSound(Diamond_sounds[i],true))return;
    if(!PrecacheSound("double_nothing_v3/button_down.wav",true))return;
    PrecacheGeneric("particles/taunt_fx.pcf",true);
    PrecacheGeneric("particles/summer2023_unusuals.pcf",true);
    PrecacheGeneric("particles/mvm.pcf",true);PrecacheGeneric("particles/item_fx.pcf",true);
    int table=FindStringTable("ParticleEffectNames");if(table==INVALID_STRING_TABLE)return;
    bool locked=LockStringTables(false);
    for(int i=0;i<sizeof(Diamond_winParticles);i++)if(FindStringIndex(table,Diamond_winParticles[i])==INVALID_STRING_INDEX)AddToStringTable(table,Diamond_winParticles[i]);
    LockStringTables(locked);
    Diamond_ready=Diamond_SeatsPrecache();
}
bool Diamond_Player(int c){return c>0&&c<=MaxClients&&IsClientInGame(c)&&IsPlayerAlive(c);}
int Diamond_Entity(int ref){int e=EntRefToEntIndex(ref);return e>MaxClients&&IsValidEntity(e)?e:-1;}
void Diamond_Remove(int s) {
    Diamond_ClearCelebration(s);
    for(int c=1;c<=MaxClients;c++)if(Diamond_seatSlot[c]==s+1)Diamond_SeatStop(c,false);
    int chair=Diamond_Entity(Diamond_machines[s].chair);if(chair!=-1)RemoveEntity(chair);
    int highlight=Diamond_Entity(Diamond_machines[s].highlight);if(highlight!=-1)RemoveEntity(highlight);
    int light=Diamond_Entity(Diamond_machines[s].light);if(light!=-1)RemoveEntity(light);
    int e=Diamond_Entity(Diamond_machines[s].body);
    if(e!=-1){StopSound(e,SNDCHAN_STATIC,Diamond_sounds[1]);StopSound(e,SNDCHAN_ITEM,Diamond_sounds[5]);StopSound(e,SNDCHAN_ITEM,Diamond_sounds[6]);StopSound(e,SNDCHAN_VOICE,Diamond_sounds[7]);RemoveEntity(e);}
    for(int i=0;i<3;i++){e=Diamond_Entity(Diamond_machines[s].reel[i]);if(e!=-1)RemoveEntity(e);}
    for(int i=0;i<9;i++){e=Diamond_Entity(Diamond_machines[s].digits[i]);if(e!=-1)RemoveEntity(e);}
    Diamond_Machine empty;Diamond_machines[s]=empty;
}
public void Diamond_OnPluginEnd(){Diamond_SlotMenusShutdown();for(int s=0;s<Diamond_COUNT;s++)Diamond_Remove(s);}
public void Diamond_OnMapEnd(){Diamond_ready=false;for(int c=1;c<=MaxClients;c++)Diamond_SeatStop(c,false);for(int s=0;s<Diamond_COUNT;s++){Diamond_Machine empty;Diamond_machines[s]=empty;}}
