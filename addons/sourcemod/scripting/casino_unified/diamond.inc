public bool Diamond_TraceWorld(int e,int mask,any data){return e==0;}
int Diamond_Prop(const char[] model,bool solid=false) {
    int e=CreateEntityByName("prop_dynamic_override");if(e==-1)return 0;
    DispatchKeyValue(e,"model",model);DispatchKeyValue(e,"solid",solid?"6":"0");
    if(!DispatchSpawn(e)){RemoveEntity(e);return 0;}
    SetEntProp(e,Prop_Data,"m_takedamage",0);
    return EntIndexToEntRef(e);
}
void Diamond_Animate(int ref,const char[] sequence){
    int e=Diamond_Entity(ref);if(e==-1)return;
    SetVariantString(sequence);AcceptEntityInput(e,"SetAnimation");
    SetEntPropFloat(e,Prop_Send,"m_flCycle",0.0);
    SetEntPropFloat(e,Prop_Send,"m_flPlaybackRate",1.0);
}
void Diamond_WorldPoint(int s,float x,float y,float z,float p[3]) {
    float rad=DegToRad(Diamond_machines[s].yaw);
    p[0]=Diamond_machines[s].origin[0]+Diamond_SCALE*(Cosine(rad)*x-Sine(rad)*y);
    p[1]=Diamond_machines[s].origin[1]+Diamond_SCALE*(Sine(rad)*x+Cosine(rad)*y);
    p[2]=Diamond_machines[s].origin[2]+Diamond_SCALE*(Diamond_BASE_HEIGHT+z);
}
void Diamond_Position(int s,int ref,float x,float y,float z) {
    int e=Diamond_Entity(ref);if(e==-1)return;
    float p[3],a[3];Diamond_WorldPoint(s,x,y,z,p);
    // studiomdl rotated SMD vertices +90 degrees about Z: (x,y,z)->(-y,x,z).
    // Only placement uses entity transforms. All motion is baked bone animation.
    a[0]=0.0;a[1]=Diamond_machines[s].yaw-90.0;a[2]=0.0;
    TeleportEntity(e,p,a,NULL_VECTOR);
}
void Diamond_UpdateCounters(int s) {
    int value=Diamond_sharedPool.IntValue;
    for(int i=7;i>=0;i--){
        int skin=(value>0||i==7)?value%10:10;value/=10;
        int e=Diamond_Entity(Diamond_machines[s].digits[i]);if(e!=-1)SetEntProp(e,Prop_Send,"m_nSkin",skin);
    }
    int e=Diamond_Entity(Diamond_machines[s].digits[8]);if(e!=-1)SetEntProp(e,Prop_Send,"m_nSkin",Diamond_machines[s].bet);
    e=Diamond_Entity(Diamond_machines[s].highlight);if(e!=-1)SetEntProp(e,Prop_Send,"m_nSkin",(Diamond_machines[s].bet-1)/2);
    e=Diamond_Entity(Diamond_machines[s].body);if(e!=-1)SetEntProp(e,Prop_Send,"m_nSkin",(Diamond_machines[s].bet+1)/2);
}
public Action Diamond_Spawn(int c,int args){Diamond_SpawnBatch(c,1,100.0);return Plugin_Handled;}
int Diamond_CreateMachine(const float p[3],float yaw){
    int s=-1;for(int i=0;i<Diamond_COUNT;i++)if(Diamond_Entity(Diamond_machines[i].body)==-1){Diamond_Remove(i);s=i;break;}
    if(s==-1)return -1;
    Diamond_machines[s].origin=p;Diamond_machines[s].yaw=yaw;Diamond_machines[s].bet=1;
    if(!Diamond_CreateChair(s)){Diamond_Remove(s);return -1;}
    Diamond_machines[s].body=Diamond_Prop(Diamond_BODY,true);
    Diamond_machines[s].highlight=Diamond_Prop(Diamond_PAYHIGHLIGHT);
    for(int i=0;i<3;i++)Diamond_machines[s].reel[i]=Diamond_Prop(Diamond_REEL);
    for(int i=0;i<9;i++)Diamond_machines[s].digits[i]=Diamond_Prop(i<8?Diamond_JACKDIGIT:Diamond_CREDITDIGIT);
    bool valid=Diamond_Entity(Diamond_machines[s].body)!=-1&&Diamond_Entity(Diamond_machines[s].highlight)!=-1;
    for(int i=0;i<3;i++)if(Diamond_Entity(Diamond_machines[s].reel[i])==-1)valid=false;
    for(int i=0;i<9;i++)if(Diamond_Entity(Diamond_machines[s].digits[i])==-1)valid=false;
    if(!valid){Diamond_Remove(s);return -1;}
    Diamond_Position(s,Diamond_machines[s].body,0.0,0.0,0.0);
    Diamond_Position(s,Diamond_machines[s].highlight,0.0,0.0,0.0);
    Diamond_Animate(Diamond_machines[s].body,"idle");
    for(int i=0;i<3;i++){
        SetVariantFloat(Diamond_SCALE);AcceptEntityInput(Diamond_Entity(Diamond_machines[s].reel[i]),"SetModelScale");
        Diamond_Position(s,Diamond_machines[s].reel[i],Diamond_reelX.FloatValue,Diamond_reelY.FloatValue+float(i)*Diamond_reelGap.FloatValue,Diamond_reelZ.FloatValue);
        Diamond_machines[s].previousSymbol[i]=1;Diamond_Animate(Diamond_machines[s].reel[i],"idle_1");
    }
    // Separate coplanar glyph/background surfaces without a floating display.
    for(int i=0;i<8;i++)Diamond_Position(s,Diamond_machines[s].digits[i],4.22,(float(i)-3.5)*2.05,46.208);
    Diamond_Position(s,Diamond_machines[s].digits[8],5.10,5.7,42.048);Diamond_UpdateCounters(s);
    int light=CreateEntityByName("light_dynamic");
    if(light==-1){Diamond_Remove(s);return -1;}
    Diamond_machines[s].light=EntIndexToEntRef(light);
    DispatchKeyValue(light,"_light","255 224 180 255");
    DispatchKeyValue(light,"brightness","2");DispatchKeyValue(light,"distance","90");
