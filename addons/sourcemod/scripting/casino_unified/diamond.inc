public int Diamond_TestHandler(Menu menu,MenuAction action,int c,int item){
    if(action==MenuAction_End) {Diamond_SlotMenuEnd(menu);return 0;}
    if(Diamond_slotEnding)return 0;
    if(!Diamond_SlotAdmin(c))return 0;
