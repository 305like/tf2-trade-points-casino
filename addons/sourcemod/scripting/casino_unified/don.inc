        for(int i=0;i<Don_seatCosmetics[c].Length;i++){
            int row[3];Don_seatCosmetics[c].GetArray(i,row);int e=Don_Entity(row[0]),clone=Don_Entity(row[2]);
            if(e!=-1&&GetEntityRenderMode(e)==RENDER_NONE)SetEntityRenderMode(e,view_as<RenderMode>(row[1]));
            if(clone!=-1)RemoveEntity(clone);
        }
