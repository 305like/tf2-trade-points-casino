public int Don_SetupHandler(Menu menu,MenuAction action,int c,int item)
{
    if(action==MenuAction_End) {Don_DonMenuEnd(menu);return 0;}
    if(Don_donEnding)return 0;
    if(action!=MenuAction_Select || !Don_DonAdmin(c)) return 0;
    char key[16];menu.GetItem(item,key,sizeof(key));
    if(StrEqual(key,"kind")) {Don_ShowMachineKind(c);
    } else if(StrEqual(key,"count") || StrEqual(key,"spacing")) {
        Don_inputMode[c]=StrEqual(key,"count")?1:2;
        PrintToChat(c,Don_inputMode[c]==1?"[더블] 설치 개수 1~32를 채팅에 입력하세요. 취소: !취소":"[더블] 중심 간격 5~2000 유닛을 채팅에 입력하세요. 취소: !취소");
    } else if(StrEqual(key,"test")) {Don_ShowTest(c);
    } else if(StrEqual(key,"all")) {
        Menu confirm=new Menu(Don_ConfirmHandler);Don_donMenus.Push(confirm);confirm.SetTitle("이 플러그인의 더블 오어 낫띵을 모두 삭제할까요?");
        confirm.AddItem("yes","모두 삭제");confirm.AddItem("no","취소");confirm.Display(c,MENU_TIME_FOREVER);
    } else {
        if(StrEqual(key,"spawn")) Don_SpawnBatch(c,Don_installCount[c],Don_installSpacing[c]);else Don_RemoveAim(c,0);
        Don_ShowSetup(c);
    }
    return 0;
}
public int Don_ConfirmHandler(Menu menu,MenuAction action,int c,int item)
{
    if(action==MenuAction_End) {Don_DonMenuEnd(menu);return 0;}
    if(Don_donEnding)return 0;
    if(action==MenuAction_Select && Don_DonAdmin(c)) {
        if(item==0) {int count;for(int s=0;s<Don_COUNT;s++) {if((Don_Entity(Don_machines[s].body)!=-1)) count++;Don_RemoveMachine(s);}PrintToChat(c,"[더블] %d대 삭제 완료.",count);}
        Don_ShowSetup(c);
    }
    return 0;
}
float Don_RowOffset(int index,int count,float spacing) {return (float(index)-float(count-1)*0.5)*spacing;}
