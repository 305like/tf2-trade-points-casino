}
int Don_AimButton(int c,int s){
    float eye[3],a[3],dir[3];Don_SeatAim(c,eye,a);GetAngleVectors(a,dir,NULL_VECTOR,NULL_VECTOR);
    float best=9999.0;int hit=-1;
    for(int i=0;i<5;i++){
        float p[3],delta[3];Don_WorldPoint(s,-Don_buttonCenters[i][0],-Don_buttonCenters[i][1],Don_buttonCenters[i][2],p);
        SubtractVectors(p,eye,delta);float along=GetVectorDotProduct(delta,dir);if(along<=0.0||along>150.0)continue;
        float dist=GetVectorDotProduct(delta,delta)-along*along,radius=i<2?2.3:0.9;
        if(dist>radius*radius||dist>=best)continue;
        Handle tr=TR_TraceRayFilterEx(eye,p,MASK_SOLID,RayType_EndPoint,Don_ControlTrace,s);bool blocked=TR_DidHit(tr);delete tr;if(blocked)continue;
        best=dist;hit=i;
    }
    return hit;
}
bool Don_Use(int c){if(!Don_Player(c)||!Don_ready)return false;if(!Don_seatSlot[c])return Don_SeatUse(c);int s=Don_seatSlot[c]-1,b=Don_AimButton(c,s);if(b>=0)Don_Press(c,s,b);return true;}
void Don_Press(int c,int s,int b){
    if(!Don_ready||!Don_Player(c)||Don_seatSlot[c]!=s+1||Don_machines[s].user!=GetClientUserId(c)||Don_machines[s].busy||GetGameTime()<Don_machines[s].due)return;
    if((b==0&&Don_machines[s].amount>Don_DOUBLE_LIMIT)||(b==1&&!Don_machines[s].amount)||(b>=2&&Don_machines[s].amount))return;
    if(b==0&&!Don_machines[s].amount){
        int round=GamePoints_Don(c,1,Don_machines[s].bet,0);
        if(round<0){Don_CasinoHint(c,"게임 포인트가 부족하거나 장부를 확인할 수 없습니다.");return;}
        Don_gameRound[s]=round;
    }
    if(b==0){
        Don_machines[s].success=Don_DonAdmin(c)&&Don_testOutcome[c]>0?Don_testOutcome[c]==1:GetRandomInt(0,1)==1;Don_testOutcome[c]=0;
        Don_gameResult[s]=GamePoints_Don(c,2,Don_machines[s].success?1:0,Don_gameRound[s]);
        if(Don_gameResult[s]<0){Don_CasinoHint(c,"게임 장부 처리 실패. 결과를 다시 확인하세요.");return;}
    }
    if(b==1&&GamePoints_Don(c,3,0,Don_gameRound[s])<0){Don_CasinoHint(c,"게임 포인트 지급을 확인하지 못했습니다. 다시 시도하세요.");return;}
    if(b<2){Don_Animate(Don_machines[s].button[b],"press");Don_machines[s].buttonUp[b]=GetGameTime()+0.25;}
    EmitSoundToAll(Don_DOWN_SOUND,Don_Entity(Don_machines[s].button[b]));
    if(b>=2){Don_machines[s].bet=1+(b-2)*2;Don_machines[s].screenState=0;Don_machines[s].due=GetGameTime()+0.5;Don_UpdateDisplay(s);return;}
    Don_machines[s].busy=true;Don_machines[s].cashing=b==1;Don_machines[s].due=GetGameTime()+0.5;
    if(b==0){if(!Don_machines[s].amount)Don_machines[s].amount=Don_machines[s].bet;Don_machines[s].screenState=1;}
    else {Don_machines[s].screenState=4;for(int copy=0;copy<2;copy++)EmitSoundToAll(Don_CASH_SOUND,Don_Entity(Don_machines[s].body),SNDCHAN_USER_BASE+3+copy);Don_LightResult(s,true);Don_CasinoHint(c,"[더블] %d 획득! 게임 포인트",Don_machines[s].amount);}
    Don_UpdateDisplay(s);
}
void Don_Finish(int s){
    Don_machines[s].busy=false;
    if(Don_machines[s].cashing){Don_machines[s].cashing=false;Don_machines[s].amount=0;Don_machines[s].wins=0;Don_UpdateDisplay(s);return;}
    Don_machines[s].amount=Don_gameResult[s];char sound[80];int pitch=100;
    if(Don_machines[s].success){Don_machines[s].wins++;int level=Don_machines[s].wins-1;if(level>7)level=7;strcopy(sound,sizeof(sound),Don_winSounds[level]);pitch=Don_WinPitch(Don_machines[s].wins);Don_machines[s].screenState=2;Don_LightResult(s,false);}
    else {strcopy(sound,sizeof(sound),Don_loseSounds[Don_LossIndex(Don_machines[s].wins)]);Don_machines[s].wins=0;Don_machines[s].screenState=3;}
    Don_UpdateDisplay(s);for(int copy=0;copy<3;copy++)EmitSoundToAll(sound,Don_Entity(Don_machines[s].body),SNDCHAN_USER_BASE+copy,SNDLEVEL_NORMAL,SND_NOFLAGS,1.0,pitch);
    LogMessage("DON result slot=%d userid=%d win=%d amount=%d",s,Don_machines[s].user,Don_machines[s].success,Don_machines[s].amount);
}
public void Don_OnGameFrame(){
    Don_CasinoHintFrame();
    if(!Don_ready)return;Don_SeatsFrame();float now=GetGameTime();
    for(int s=0;s<Don_COUNT;s++)if(Don_Entity(Don_machines[s].body)!=-1){
        for(int b=0;b<5;b++)if(Don_machines[s].buttonUp[b]>0.0&&now>=Don_machines[s].buttonUp[b]){Don_machines[s].buttonUp[b]=0.0;Don_Animate(Don_machines[s].button[b],"release");EmitSoundToAll(Don_UP_SOUND,Don_Entity(Don_machines[s].button[b]),SNDCHAN_AUTO,SNDLEVEL_NORMAL,SND_NOFLAGS,1.0,150);}
        if(Don_machines[s].lightUntil>0.0&&now>=Don_machines[s].lightUntil){Don_machines[s].lightUntil=0.0;int e=Don_Entity(Don_machines[s].light);if(e!=-1)AcceptEntityInput(e,"TurnOff");}
        if(Don_machines[s].busy&&now>=Don_machines[s].due)Don_Finish(s);
    }
}
public Action Don_OnPlayerRunCmd(int c,int &buttons,int &impulse,float vel[3],float angles[3],int &weapon){
    int old=Don_previous[c];Don_previous[c]=buttons;bool use=(buttons&IN_USE)&&!(old&IN_USE);
    if(Don_seatSlot[c]){
        if((buttons&IN_DUCK)&&!(old&IN_DUCK)){Don_SeatStop(c,true);if(!Don_seatSlot[c])return Plugin_Changed;}
        if((buttons&IN_ATTACK3)&&!(old&IN_ATTACK3))Don_seatThird[c]=!Don_seatThird[c];
        if(use||((buttons&IN_ATTACK)&&!(old&IN_ATTACK)))Don_Use(c);
        if((buttons&IN_JUMP)&&!(old&IN_JUMP))Don_Press(c,Don_seatSlot[c]-1,0);
        buttons&=~(IN_ATTACK|IN_ATTACK2|IN_ATTACK3|IN_JUMP|IN_DUCK|IN_USE|IN_RELOAD|IN_FORWARD|IN_BACK|IN_MOVELEFT|IN_MOVERIGHT);buttons|=IN_DUCK;Don_SeatPhysicsHold(c);
        vel[0]=vel[1]=vel[2]=0.0;weapon=0;return Plugin_Changed;
    }
    if(use&&Don_Use(c)){buttons&=~IN_USE;return Plugin_Changed;}return Plugin_Continue;
}
public Action Don_Voice(int c,const char[] command,int argc){char a[8],b[8];GetCmdArg(1,a,sizeof(a));GetCmdArg(2,b,sizeof(b));return StrEqual(a,"0")&&StrEqual(b,"0")&&Don_Use(c)?Plugin_Handled:Plugin_Continue;}
public Action Don_Chat(int c,const char[] command,int argc){
    char text[80];GetCmdArgString(text,sizeof(text));StripQuotes(text);TrimString(text);
    if(!StrEqual(text,"!더블삭제"))return Plugin_Continue;
    if(Don_DonAdmin(c))Don_RemoveAim(c,0);return Plugin_Handled;
}
public Action Don_RemoveAim(int c,int args){if(Don_Player(c)){int s=Don_Aim(c);if(s>=0){Don_RemoveMachine(s);ReplyToCommand(c,"[더블] 삭제 완료.");}}return Plugin_Handled;}
public Action Don_Status(int c,int args){int count,seats;for(int s=0;s<Don_COUNT;s++)if(Don_Entity(Don_machines[s].body)!=-1)count++;for(int p=1;p<=MaxClients;p++)if(Don_seatSlot[p])seats++;ReplyToCommand(c,"Double or Nothing 0.4.0 ready=%d machines=%d seated=%d game_points=enabled item_exchange=disabled",Don_ready,count,seats);return Plugin_Handled;}
public Action Don_Verify(int c,int args){
    if(!Don_ready||GetEntityCount()>GetMaxEntities()-100){ReplyToCommand(c,"DON verify FAIL not ready/capacity");return Plugin_Handled;}
    int s=-1;for(int i=0;i<Don_COUNT;i++)if(Don_Entity(Don_machines[i].body)==-1){s=i;break;}if(s==-1)return Plugin_Handled;
    Don_machines[s].origin[2]=-16000.0;
    bool ok=Don_CreateParts(s,false);
    if(ok){for(int state=0;state<5;state++){Don_machines[s].screenState=state;Don_machines[s].amount=1234567890;Don_machines[s].wins=21;Don_UpdateDisplay(s);if(GetEntProp(Don_Entity(Don_machines[s].screen),Prop_Send,"m_nSkin")!=state)ok=false;}
        for(int b=0;b<2;b++){Don_Animate(Don_machines[s].button[b],"press");Don_Animate(Don_machines[s].button[b],"release");}
        int amounts[]={0,2,4,8,16,10,20,40,80,2147483646};
        for(int test=0;test<sizeof(amounts);test++){
            Don_machines[s].amount=amounts[test];Don_machines[s].screenState=2;Don_machines[s].wins=21;Don_UpdateDisplay(s);
            int value=amounts[test];
            for(int i=9;i>=0;i--){if(GetEntProp(Don_Entity(Don_machines[s].digit[i]),Prop_Send,"m_nSkin")!=(value>0||i==9?value%10:10))ok=false;value/=10;}
            if(GetEntProp(Don_Entity(Don_machines[s].digit[10]),Prop_Send,"m_nSkin")!=2||GetEntProp(Don_Entity(Don_machines[s].digit[11]),Prop_Send,"m_nSkin")!=1)ok=false;
        }
        Don_machines[s].screenState=0;
        for(int bet=1;bet<=5;bet+=2){Don_machines[s].bet=bet;Don_UpdateDisplay(s);if(GetEntProp(Don_Entity(Don_machines[s].screen),Prop_Send,"m_nSkin")!=(bet==1?0:4+(bet-1)/2))ok=false;}
        for(int b=2;b<5;b++)if(GetEntProp(Don_Entity(Don_machines[s].button[b]),Prop_Send,"m_nSequence")!=0)ok=false;
        Don_LightResult(s,false);Don_LightResult(s,true);
    }
    Don_RemoveMachine(s);
    if(!Don_SeatCameraVerify())ok=false;
    ReplyToCommand(c,"DON verify %s: parts creation, five screen states, digit skins, buttons, light, cleanup; live seating untested",ok?"PASS":"FAIL");return Plugin_Handled;
}
