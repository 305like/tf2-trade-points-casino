    if(e==Don_Entity(Don_machines[s].body)||e==Don_Entity(Don_machines[s].chair)||e==Don_Entity(Don_machines[s].screen))return false;
    for(int i=0;i<5;i++)if(e==Don_Entity(Don_machines[s].button[i]))return false;
