public Action Don_DonChat(int c,const char[] command,int argc)
{
    if(Don_donEnding)return Plugin_Continue;
    char text[128];GetCmdArgString(text,sizeof(text));StripQuotes(text);TrimString(text);
    if(c<1 || !IsClientInGame(c)) return Plugin_Continue;
    if(StrEqual(text,"!도박")||StrEqual(text,"/도박")){if(Don_DonAdmin(c))Don_GambleCommand(c,0);else PrintToChat(c,"[도박] 어드민 전용입니다.");return Plugin_Handled;}
    if(StrEqual(text,"!더블") || StrEqual(text,"!더블오어낫띵") || StrEqual(text,"!더블설치") || StrEqual(text,"/더블")) {
        if(Don_DonAdmin(c)) Don_SetupCommand(c,0);
        else PrintToChat(c,"[더블] 어드민 전용입니다.");
        return Plugin_Handled;
    }
    if(Don_inputMode[c]!=0) {
        if(!Don_DonAdmin(c)) {Don_inputMode[c]=0;return Plugin_Continue;}
        if(StrEqual(text,"!취소") || StrEqual(text,"취소")) {Don_inputMode[c]=0;Don_ShowSetup(c);return Plugin_Handled;}
        if(text[0]=='!' || text[0]=='/') {Don_inputMode[c]=0;return Plugin_Continue;}
        int number;
        if(!Don_ParseSetting(text,Don_inputMode[c],number)) {PrintToChat(c,"[더블] 개수 1~32 / 중심 간격 5~2000의 정수를 입력하세요. 취소: !취소");return Plugin_Handled;}
        if(Don_inputMode[c]==1) Don_installCount[c]=number;else Don_installSpacing[c]=float(number);
        Don_inputMode[c]=0;Don_ShowSetup(c);return Plugin_Handled;
    }
    return Plugin_Continue;
}
bool Don_ParseSetting(const char[] text,int mode,int &number)
{
    int length=strlen(text);if(length==0 || length>4) return false;
    for(int i=0;i<length;i++) if(text[i]<'0' || text[i]>'9') return false;
    number=StringToInt(text);return mode==1?(number>=1 && number<=32):(number>=5 && number<=2000);
}
public Action Don_SetupCommand(int c,int args)
{
    if(!Don_donEnding && Don_DonAdmin(c)) {Don_inputMode[c]=0;Don_ShowSetup(c);}return Plugin_Handled;
}
void Don_DonMenuEnd(Menu menu){
    if(Don_donEnding)return;
    int index=Don_donMenus.FindValue(menu);
    if(index==-1)return;
    Don_donMenus.Erase(index);delete menu;
}
void Don_DonMenusShutdown(){
    Don_donEnding=true;
    // Destroy while callbacks are still alive; End callbacks must not delete twice.
    while(Don_donMenus!=null && Don_donMenus.Length>0){
        int last=Don_donMenus.Length-1;Menu menu=view_as<Menu>(Don_donMenus.Get(last));
        Don_donMenus.Erase(last);menu.Cancel();delete menu;
    }
    delete Don_donMenus;
}
void Don_ShowSetup(int c)
{
