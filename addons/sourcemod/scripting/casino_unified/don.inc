void Don_UpdateDisplay(int s){
    int state=Don_machines[s].screenState;
    Don_Skin(Don_machines[s].screen,state==0&&Don_machines[s].bet>1?4+(Don_machines[s].bet-1)/2:state);
    int n=Don_machines[s].amount;
    int length=1;for(int value=n;value>=10;value/=10)length++;
    float offset=-float(10-length)*0.085/2.0,a=DegToRad(Don_machines[s].yaw+180.0),p[3];
    p=Don_machines[s].origin;
    p[0]+=offset*(Cosine(a)*0.0000198101-Sine(a)*-21.2530468);
    p[1]+=offset*(Sine(a)*0.0000198101+Cosine(a)*-21.2530468);
    p[2]+=offset*-0.10448234;
    for(int i=0;i<10;i++){int e=Don_Entity(Don_machines[s].digit[i]);if(e!=-1)TeleportEntity(e,p,NULL_VECTOR,NULL_VECTOR);}
    for(int i=9;i>=0;i--){Don_Skin(Don_machines[s].digit[i],n>0||i==9?n%10:10);n/=10;}
    // Keep the first visible streak digit beside x, without a blank tens column.
    float du=Don_StreakOffset(Don_machines[s].wins),dv=-0.034;
    float dx=du*0.0000198101+dv*-1.41956236,dy=du*-21.2530468+dv*0.06296401;
    p=Don_machines[s].origin;p[0]+=Cosine(a)*dx-Sine(a)*dy;p[1]+=Sine(a)*dx+Cosine(a)*dy;p[2]+=du*-0.10448234+dv*-12.807956;
    for(int i=10;i<12;i++){int e=Don_Entity(Don_machines[s].digit[i]);if(e!=-1)TeleportEntity(e,p,NULL_VECTOR,NULL_VECTOR);}
    Don_Skin(Don_machines[s].digit[10],state==2&&Don_machines[s].wins>=10?(Don_machines[s].wins/10)%10:10);Don_Skin(Don_machines[s].digit[11],state==2?Don_machines[s].wins%10:10);Don_Skin(Don_machines[s].digit[12],10);
    Don_Skin(Don_machines[s].button[0],!Don_machines[s].busy&&Don_machines[s].amount<=Don_DOUBLE_LIMIT?1:0);
    Don_Skin(Don_machines[s].button[1],!Don_machines[s].busy&&Don_machines[s].amount>0?1:0);
    for(int i=2;i<5;i++)Don_Skin(Don_machines[s].button[i],Don_machines[s].bet==1+(i-2)*2?1:0);
}
