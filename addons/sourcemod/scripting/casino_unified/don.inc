int Don_Aim(int c){
    float eye[3],a[3];GetClientEyePosition(c,eye);GetClientEyeAngles(c,a);
    Handle tr=TR_TraceRayFilterEx(eye,a,MASK_SOLID,RayType_Infinite,Don_AimTrace,c);int e=TR_DidHit(tr)?TR_GetEntityIndex(tr):-1;float p[3];TR_GetEndPosition(p,tr);delete tr;
    if(GetVectorDistance(eye,p)>200.0)return -1;
    for(int s=0;s<Don_COUNT;s++)if(e>MaxClients&&(Don_Entity(Don_machines[s].body)==e||Don_Entity(Don_machines[s].chair)==e))return s;return -1;
}
public bool Don_ControlTrace(int e,int mask,any s){
