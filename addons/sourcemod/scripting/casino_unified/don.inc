bool Don_DonAdmin(int c){return c>0&&IsClientInGame(c)&&(GetUserFlagBits(c)&(ADMFLAG_GENERIC|ADMFLAG_ROOT))!=0&&CheckCommandAccess(c,"sm_doublenothing",ADMFLAG_GENERIC);}
void Don_DonSetupInit(){
    Don_donMenus=new ArrayList();
    RegAdminCmd("sm_gamble",Don_GambleCommand,ADMFLAG_GENERIC);
    RegAdminCmd("sm_gamble_kind",Don_GambleKindCommand,ADMFLAG_GENERIC);
    RegAdminCmd("sm_gamble_list",Don_GambleListCommand,ADMFLAG_GENERIC);
    RegAdminCmd("sm_doublenothing",Don_SetupCommand,ADMFLAG_GENERIC);
    AddCommandListener(Don_DonChat,"say");AddCommandListener(Don_DonChat,"say_team");
    int n;
    if(!Don_ParseSetting("5",2,n)||n!=5||Don_ParseSetting("4",2,n)||Don_ParseSetting("2001",2,n)
       ||!Don_ParseSetting("32",1,n)||Don_ParseSetting("33",1,n)||Don_ParseSetting("5x",2,n)
       ||FloatAbs(Don_RowOffset(0,2,5.0)+2.5)>0.001||FloatAbs(Don_RowOffset(1,2,5.0)-2.5)>0.001)
       SetFailState("Don setup bounds/spacing selftest failed");
