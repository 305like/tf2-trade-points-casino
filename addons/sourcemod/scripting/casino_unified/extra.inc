    if(Extra_seatPushaway!=null&&!IsFakeClient(c)){
        char value[16];Extra_seatPushaway.GetString(value,sizeof(value));SendConVarValue(c,Extra_seatPushaway,value);
    }
    Extra_SeatViewStop(c);
