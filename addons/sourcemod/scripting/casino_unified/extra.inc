    float point[3];bool place=Extra_Player(c)&&Extra_SeatExitPoint(c,s,point);
    if(requested&&!place){PrintToChat(c,"[더블] 하차할 공간이 없습니다.");return;}
#if defined DON_GAME_POINTS
    if(gameRound[s]>0&&!Extra_machines[s].cashing){if(Extra_machines[s].busy)Finish(s);GamePoints_Don(c,3,0,gameRound[s]);}
