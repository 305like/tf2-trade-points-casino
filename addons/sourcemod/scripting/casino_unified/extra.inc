    if(StrEqual(current,Extra_SEAT_CAMERA_RIG)){
        SetVariantString(Extra_seatOldModel[c]);AcceptEntityInput(c,"SetCustomModel");SetEntProp(c,Prop_Send,"m_bUseClassAnimations",Extra_seatAnimations[c]);
        SetEntProp(c,Prop_Send,"m_nSkin",Extra_seatSkin[c]);SetEntProp(c,Prop_Send,"m_nBody",Extra_seatGroups[c]);
        Extra_SeatViewRestoreModel(c);
    }
    int body=Extra_Entity(Extra_seatBody[c]);Extra_seatBody[c]=INVALID_ENT_REFERENCE;if(body!=-1)RemoveEntity(body);
    if(GetEntityRenderFx(c)==RENDERFX_FADE_FAST)SetEntityRenderFx(c,Extra_seatFx[c]);
    SetEntProp(c,Prop_Send,"m_nForceTauntCam",0);SetEntPropVector(c,Prop_Data,"m_vecViewOffset",Extra_seatOldEye[c]);
    if(GetEntityMoveType(c)==MOVETYPE_NONE)SetEntityMoveType(c,Extra_seatMove[c]);
    if(place){float zero[3];TeleportEntity(c,point,NULL_VECTOR,zero);}
    Extra_SeatPhysicsRestore(c);
    Extra_Release(s);
    LogMessage("DON seat exit userid=%d slot=%d",GetClientUserId(c),s);
}
void Extra_SeatsFrame(){
