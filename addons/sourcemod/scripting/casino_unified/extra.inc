void Extra_Sound(int g,int sound){
    int e=Extra_Entity(Extra_games[g].body);if(e==-1)return;char path[128];if(sound<sizeof(Extra_audio))Extra_SoundPath(sound,path,sizeof(path));
    if(Extra_games[g].kind==1){
        if(sound==8||sound==9){int c=Extra_Seated(g*6);if(!c||!Extra_rounds[c].wheelSpin)return;}
        int cue=-1;
        if(sound==0)cue=0;
        else if(sound==23)cue=GetRandomInt(1,3);
        else if(sound==8)cue=4;
        else if(sound==9){
            // Stop the prior ready cue before announcing the next bonus.
            for(int i=7;i<=11;i++){
                char previousCue[128];Extra_WheelSoundPath(i,previousCue,sizeof(previousCue));StopSound(e,SNDCHAN_AUTO,previousCue);
                for(int s=g*6;s<g*6+6;s++){int c=Extra_Seated(s);if(c)StopSound(c,SNDCHAN_AUTO,previousCue);}
            }
            cue=GetRandomInt(7,11);
        }
        else if(sound>=24&&sound<=26){
            // The original cabinet Speaker replaces its previous win cue.
            for(int i=12;i<=14;i++){
                char prior[128];Extra_WheelSoundPath(i,prior,sizeof(prior));StopSound(e,SNDCHAN_AUTO,prior);
                for(int s=g*6;s<g*6+6;s++){int c=Extra_Seated(s);if(c)StopSound(c,SNDCHAN_AUTO,prior);}
            }
            cue=sound-12;
        }
        else if(sound>=27&&sound<=30)cue=sound==27?5:(sound==28?6:(sound==29?15:16));
        else if(sound==31)cue=17;
        if(cue>=0)Extra_WheelSoundPath(cue,path,sizeof(path));
    }
    if(!path[0])return;
    float pos[3];pos=Extra_games[g].origin;pos[2]+=Extra_CABINET_HEIGHT+28.8;
    int channel=sound==22?SNDCHAN_STATIC:SNDCHAN_AUTO;
    // Match Diamond's playback gain; preserve the original wheel-loop pitch variation.
    float volume=1.0;
    int pitch=(Extra_games[g].kind==1&&sound==22)?GetRandomInt(100,101):SNDPITCH_NORMAL;
    for(int c=1;c<=MaxClients;c++)if(IsClientInGame(c)&&!IsFakeClient(c)){
        if(Extra_GameOf(c)==g)EmitSoundToClient(c,path,c,channel,SNDLEVEL_NONE,SND_NOFLAGS,volume,pitch);
        else EmitSoundToClient(c,path,e,channel,SNDLEVEL_NORMAL,SND_NOFLAGS,volume,pitch,-1,pos,NULL_VECTOR,false);
    }
}
