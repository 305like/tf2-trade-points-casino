public bool Extra_ExtraInstallTrace(int e,int mask,any c){return e==0||e>MaxClients;}
void Extra_ExtraBatch(int c){
    if(!Extra_Admin(c)||!Extra_ready||Extra_seatSlot[c])return;
    int count=Extra_extraCount[c],kind=Extra_extraKind[c],free;
    for(int g=0;g<Extra_GAMES;g++)if(Extra_Entity(Extra_games[g].body)==-1)free++;
    if(count<1||count>free||GetEntityCount()+count*24>GetMaxEntities()-64){PrintToChat(c,"[카지노] 설치 공간 또는 엔티티 한도가 부족합니다.");return;}
    float eye[3],a[3],hit[3],normal[3];GetClientEyePosition(c,eye);GetClientEyeAngles(c,a);
    Handle tr=TR_TraceRayFilterEx(eye,a,MASK_SOLID,RayType_Infinite,Extra_ExtraInstallTrace,c);
    bool found=TR_DidHit(tr)&&!TR_StartSolid(tr);TR_GetEndPosition(hit,tr);TR_GetPlaneNormal(tr,normal);delete tr;
    if(!found||normal[2]<0.65||GetVectorDistance(eye,hit)>800.0){PrintToChat(c,"[카지노] 800유닛 이내의 평평한 바닥을 보세요.");return;}
    float positions[Extra_GAMES][3],rad=DegToRad(a[1]);
    float mins[3]={-24.0,-24.0,1.0},maxs[3]={24.0,24.0,123.0};
    if(kind>=5){mins[0]=mins[1]=-125.0;maxs[0]=maxs[1]=125.0;maxs[2]=145.0;}
    for(int i=0;i<count;i++){
        float start[3],end[3],offset=(float(i)-float(count-1)*0.5)*Extra_extraSpacing[c];start=hit;
        start[0]+=Sine(rad)*offset;start[1]-=Cosine(rad)*offset;start[2]+=50.0;end=start;end[2]-=100.0;
        tr=TR_TraceRayFilterEx(start,end,MASK_SOLID,RayType_EndPoint,Extra_ExtraInstallTrace,c);
        found=TR_DidHit(tr)&&!TR_StartSolid(tr);TR_GetEndPosition(positions[i],tr);TR_GetPlaneNormal(tr,normal);delete tr;
        if(!found||normal[2]<0.65||FloatAbs(positions[i][2]-hit[2])>48.0){PrintToChat(c,"[카지노] %d번째 바닥이 없어 설치 취소.",i+1);return;}
        positions[i][2]+=0.1;tr=TR_TraceHullFilterEx(positions[i],positions[i],mins,maxs,MASK_SOLID,Extra_ExtraInstallTrace,c);
        bool blocked=TR_DidHit(tr)||TR_StartSolid(tr)||TR_AllSolid(tr);delete tr;
        if(blocked){PrintToChat(c,"[카지노] %d번째 위치가 막혀 설치 취소.",i+1);return;}
    }
    int created[Extra_GAMES];
    for(int i=0;i<count;i++){created[i]=Extra_CreateGame(c,kind,positions[i],a[1]+180.0);if(created[i]<0){for(int j=0;j<i;j++)Extra_Remove(created[j]);PrintToChat(c,"[카지노] 생성 실패: 이번 묶음 설치를 되돌렸습니다.");return;}}
    PrintToChat(c,"[카지노] %d대 설치 / 중심 간격 %.0f",count,Extra_extraSpacing[c]);
}
