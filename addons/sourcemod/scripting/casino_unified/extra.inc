bool Extra_SeatPlayerOverlap(const float p[3],const float origin[3],const float mins[3],const float maxs[3]){
    return p[0]+24.0>origin[0]+mins[0]&&p[0]-24.0<origin[0]+maxs[0]
        &&p[1]+24.0>origin[1]+mins[1]&&p[1]-24.0<origin[1]+maxs[1]
        &&p[2]+82.0>origin[2]+mins[2]&&p[2]<origin[2]+maxs[2];
}
bool Extra_SeatExitClear(int c,float point[3]){
    float base[3];base=point;
    for(int step=0;step<=6;step++){
        point=base;point[2]+=float(step)*8.0;
        if(!Extra_SeatClear(c,point))continue;
        // Raise above overlapping players, rechecking the complete hull against ceilings.
        for(int pass=0;pass<=MaxClients;pass++){
            int blocker;float top=point[2];
            for(int other=1;other<=MaxClients;other++)if(other!=c&&Extra_Player(other)){
                float origin[3],mins[3],maxs[3];GetClientAbsOrigin(other,origin);
                GetClientMins(other,mins);GetClientMaxs(other,maxs);
                if(Extra_SeatPlayerOverlap(point,origin,mins,maxs)){
                    blocker=other;if(origin[2]+maxs[2]+2.0>top)top=origin[2]+maxs[2]+2.0;
                }
            }
            if(!blocker)return true;
            point[2]=top;if(!Extra_SeatClear(c,point))break;
        }
    }
    return false;
}
bool Extra_SeatExitPoint(int c,int s,float point[3]){
    for(int i=0;i<8;i++){
        float a=DegToRad(Extra_machines[s].yaw+float(i)*45.0),start[3],end[3];start=Extra_machines[s].chairOrigin;
        start[0]+=Cosine(a)*65.0;start[1]+=Sine(a)*65.0;start[2]+=50.0;end=start;end[2]-=100.0;
        Handle tr=TR_TraceRayFilterEx(start,end,MASK_PLAYERSOLID,RayType_EndPoint,Extra_SeatTrace,c);
        if(!TR_DidHit(tr)||TR_StartSolid(tr)||TR_AllSolid(tr)){delete tr;continue;}float normal[3];TR_GetEndPosition(point,tr);TR_GetPlaneNormal(tr,normal);delete tr;
        if(FloatAbs(point[2]-Extra_machines[s].chairOrigin[2])>48.0)continue;
        point[2]+=2.0;if(normal[2]>=0.7&&Extra_SeatExitClear(c,point))return true;
    }
    point=Extra_seatEntry[c];point[2]+=2.0;return Extra_SeatExitClear(c,point);
}
void Extra_SeatStop(int c,bool requested){
    if(c<1||c>MaxClients||!Extra_seatSlot[c])return;
    int s=Extra_seatSlot[c]-1;
