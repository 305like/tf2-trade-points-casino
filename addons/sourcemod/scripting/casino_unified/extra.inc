    // Tick at pointer/sector crossings on the same integrated curve as the model, without catch-up bursts after lag.
    for(int c=1;c<=MaxClients;c++)if(Extra_Player(c)&&Extra_seatSlot[c]&&Extra_rounds[c].wheelSpin&&now<Extra_rounds[c].due){
        int wheel=Extra_Entity(Extra_games[Extra_GameOf(c)].wheel);
        if(wheel!=-1){
            float cycle=(now-Extra_rounds[c].wheelStarted)/Extra_WHEEL_SECONDS;
            if(cycle<0.0)cycle=0.0;if(cycle>0.998)cycle=0.998;
            SetEntPropFloat(wheel,Prop_Send,"m_flPlaybackRate",0.0);
            SetEntPropFloat(wheel,Prop_Send,"m_flCycle",cycle);
        }
        int ticks=RoundToFloor(Extra_WheelProgress(now-Extra_rounds[c].wheelStarted)*float(Extra_rounds[c].wheelTravel)+0.5);
        if(ticks>Extra_rounds[c].wheelTicks){Extra_rounds[c].wheelTicks=ticks;Extra_Sound(Extra_GameOf(c),8);}
    }
    if(now<Extra_nextFrame)return;Extra_nextFrame=now+0.1;
    for(int c=1;c<=MaxClients;c++)if(Extra_Player(c)&&Extra_seatSlot[c]){
        int g=Extra_GameOf(c),kind=Extra_games[g].kind;
        if(kind<=1&&Extra_rounds[c].phase==1&&!Extra_rounds[c].wheelSpin&&!Extra_rounds[c].reelStarted){if(now>=Extra_rounds[c].due)Extra_StartReels(c,now);else continue;}
        if(kind<=1&&Extra_rounds[c].phase==1&&!Extra_rounds[c].wheelSpin&&Extra_rounds[c].stops<3&&now>=Extra_rounds[c].nextStop){Extra_HoldReel(g,Extra_rounds[c].stops);Extra_rounds[c].stops++;Extra_rounds[c].nextStop+=Extra_slotDelay.FloatValue/3.0;Extra_Sound(g,23);}
        if(Extra_rounds[c].phase&&now>=Extra_rounds[c].due){
            if(kind==1&&Extra_rounds[c].wheelSpin)Extra_FinishWheel(c);
            else if(kind<=1)Extra_ResolveSlot(c);
            else if(kind==2)Extra_DrawPoker(c);else if(kind==3)Extra_FinishBJ(c);
            else if(kind==4){int n=Extra_rounds[c].draw[Extra_rounds[c].drawn++];if(Extra_rounds[c].picks[n])Extra_rounds[c].hits++;Extra_Sound(g,16);char text[128];Format(text,sizeof(text),"KENO %d · %d/20 · HIT %d",n+1,Extra_rounds[c].drawn,Extra_rounds[c].hits);Extra_Label(g,text);if(Extra_rounds[c].drawn==20){int pay=Extra_KenoPay(Extra_rounds[c].picked,Extra_rounds[c].hits)*Extra_rounds[c].wager;Extra_Sound(g,17);Extra_Result(c,pay,text);}else Extra_rounds[c].due=now+0.5;}
        }
    }
    for(int g=0;g<Extra_GAMES;g++)if(Extra_games[g].phase){
        if(Extra_games[g].kind==6&&Extra_games[g].phase==2){Extra_RaceFrame(g,now);continue;}
        if(now<Extra_games[g].due)continue;
        if(Extra_games[g].phase==1){Extra_games[g].phase=2;Extra_games[g].count=0;Extra_games[g].lineWon=false;for(int i=0;i<80;i++)Extra_games[g].called[i]=false;if(Extra_games[g].kind==5){Extra_CasinoShuffle(Extra_games[g].order,75);Extra_games[g].due=now+Extra_bingoDelay.FloatValue;}else{Extra_games[g].winner=GetRandomInt(0,7);Extra_games[g].due=now+Extra_raceDuration.FloatValue;Extra_Sound(g,20);}Extra_Label(g,"ROUND STARTED · BETTING CLOSED");Extra_GroupRefresh(g);}
        else if(Extra_games[g].phase==2)Extra_BingoCall(g);
        else{Extra_games[g].phase=0;Extra_Label(g,"READY · TEST ODDS / VIRTUAL CHIPS");Extra_GroupRefresh(g);}
    }
}
